---
import Base from '../../layouts/Base.astro';
import { coverOf, isReleased } from '../../lib/covers';
import LyricCard from '../../components/LyricCard.astro';
import ShareRow from '../../components/ShareRow.astro';
import ArtImg from '../../components/ArtImg.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';
import { ALBUMS } from '../../lib/albums';

export async function getStaticPaths() {
  const singles = (await getCollection('music')).filter((r) => r.data.kind !== 'playlist');
  const albums = [...new Set(singles.map((s) => s.data.album ?? 1))];
  return albums.flatMap((album) => {
    const group = singles
      .filter((s) => (s.data.album ?? 1) === album)
      .sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
    return group.map((song, i) => ({
      params: { slug: song.id },
      props: { song, prev: group[i - 1] ?? null, next: group[i + 1] ?? null },
    }));
  });
}

const { song, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site?.href ?? 'https://shinya-music.com/').replace(/\/$/, '');
const behind = (await getCollection('blog')).find(
  (p) => p.id === `behind-${song.id}` && !p.data.draft && p.data.date.valueOf() <= Date.now(),
);
const cover = coverOf(song);
// Album 11 is not in the table until its jacket lands, so this can be missing.
const album = ALBUMS.find((a) => a.n === (song.data.album ?? 1));
// Original-line tracks are titled in Japanese with titleEn alongside; the CLUB
// and AFTER lines are titled in English and carry no titleEn. Only bracket the
// English name when it is actually a second name.
const enTitle = song.data.titleEn
  ? `${song.data.title} (${song.data.titleEn})`
  : song.data.title;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'MusicRecording',
  name: song.data.title,
  alternateName: song.data.titleEn,
  position: song.data.track,
  byArtist: { '@type': 'MusicGroup', name: 'SHINYA / 深夜' },
  inAlbum: { '@type': 'MusicAlbum', name: album?.name ?? 'SHINYA' },
  datePublished: song.data.releaseDate,
  url: `${site}${base}/music/${song.id}/`,
};
---

<Base title={`${enTitle} — SHINYA / 深夜`} description={song.data.description} ogImage={cover}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="container">
    <article class="section song-page">
      <header class="song-hero">
        {cover && <ArtImg class="song-hero-art" src={cover} width={1280} sizes="(min-width: 900px) 820px, 100vw" />}
        <div class="song-hero-scrim" aria-hidden="true"></div>
        <a class="back-link" href={`${base}/music/#album-${song.data.album ?? 1}`}>{t('en', 'back.music')}</a>
        <p class="post-meta">{album && <><a class="song-album" href={`${base}/music/#album-${album.n}`}>{album.name}</a> · </>}Track {song.data.track} · {isReleased(song) ? song.data.releaseDate : t('en', 'badge.coming')}</p>
        <h1 class="song-title">{song.data.title}</h1>
        {(song.data.titleEn ?? song.data.titleJa) && <p class="song-sub">{song.data.titleEn ?? song.data.titleJa}</p>}
        <p class="song-desc">{song.data.description}</p>
        {behind && (
          <p class="song-behind"><a href={`${base}/blog/${behind.id}/`}>Read the story behind this track →</a></p>
        )}
      </header>

      {song.data.youtubeId && isReleased(song) && (
        <div class="song-video">
          <LiteYouTube id={song.data.youtubeId} title={song.data.title} poster={cover} />
        </div>
      )}

      <section class="lyrics">
        <h2>{t('en', 'song.lyrics')}</h2>
        <LyricCard songTitle={song.data.title} songSub={song.data.titleEn ?? song.data.titleJa} poster={cover} songId={song.id} lang="en" />
        {song.data.lyrics ? (
          <div class="lyrics-cols">
            <div class="lyrics-block">
              <h3>{t('en', 'song.original')}</h3>
              {song.data.lyrics.map((line) => (line ? <p>{line}</p> : <p class="lyrics-gap">&nbsp;</p>))}
            </div>
            {song.data.lyricsEn && (
              <div class="lyrics-block">
                <h3>{t('en', 'song.translation')}</h3>
                {song.data.lyricsEn.map((line) => (line ? <p>{line}</p> : <p class="lyrics-gap">&nbsp;</p>))}
              </div>
            )}
          </div>
        ) : (
          <p class="lyrics-soon">{t('en', 'song.lyrics.soon')}</p>
        )}
      </section>

      <ShareRow title={`${enTitle} — SHINYA`} lang="en" />

      {(prev || next) && (
        <nav class="post-nav">
          {prev ? (
            <a class="post-nav-link" href={`${base}/music/${prev.id}/`}>
              <span class="post-nav-label">← Track {prev.data.track}</span>
              <span class="post-nav-title">{prev.data.title}</span>
            </a>
          ) : <span />}
          {next ? (
            <a class="post-nav-link next" href={`${base}/music/${next.id}/`}>
              <span class="post-nav-label">Track {next.data.track} →</span>
              <span class="post-nav-title">{next.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}
    </article>
  </div>
</Base>
