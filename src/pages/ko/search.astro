---
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base lang="ko" title="검색 — SHINYA / 深夜" description="곡, 가사, 블로그 글을 검색하세요.">
  <div class="container">
    <section class="section search-page" data-pagefind-ignore>
      <h2>검색</h2>
      <p class="search-note">곡 제목, 가사 한 구절, 블로그 글을 검색해보세요.</p>
      <div id="search"></div>
    </section>
  </div>
</Base>

<link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
<script is:inline src={`${base}/pagefind/pagefind-ui.js`}></script>
<script is:inline data-astro-rerun define:vars={{ base }}>
  // After a client-side navigation the pagefind-ui.js tag loads
  // asynchronously, so wait for it instead of checking once and giving up.
  (function initSearch() {
    const el = document.getElementById('search');
    if (!el || el.childElementCount > 0) return;
    if (window.PagefindUI) {
      new window.PagefindUI({
        element: '#search',
        bundlePath: `${base}/pagefind/`,
        showSubResults: true,
        showImages: false,
      });
      return;
    }
    let s = document.querySelector('script[src$="pagefind-ui.js"]');
    if (!s) {
      s = document.createElement('script');
      s.src = `${base}/pagefind/pagefind-ui.js`;
      document.head.appendChild(s);
    }
    s.addEventListener('load', initSearch, { once: true });
    setTimeout(initSearch, 400);
  })();
</script>
