  <div class="container">
    <section class="page-banner">
      <ArtImg class="page-banner-art" src="images/music-banner.jpg" width={1920} sizes="(min-width: 1800px) 1160px, (min-width: 1000px) 920px, 100vw" loading="eager" />
      <div class="page-banner-scrim" aria-hidden="true"></div>
      <div class="page-banner-inner">
        <h1 class="page-banner-title">深夜 MUSIC</h1>
        <p class="page-banner-sub">다크 일렉트로닉 J-POP · 앨범 5장 · 36곡 + 믹스</p>
      </div>
    </section>


    <div class="album-tabs" role="tablist" aria-label="앨범">
      <button type="button" role="tab" class="album-tab active" aria-selected="true" data-album-tab="5">
        <ArtImg class="album-tab-art" src="images/covers/album-5.jpg" width={2048} sizes="(min-width: 700px) 48px, 45vw" alt="" />
        <span class="album-tab-text"><span class="album-tab-no">5집</span><span class="album-tab-name">誰かの部屋で</span></span>
      </button>
      <button type="button" role="tab" class="album-tab" aria-selected="false" data-album-tab="4">
        <ArtImg class="album-tab-art" src="images/covers/album-4.jpg" width={2048} sizes="(min-width: 700px) 48px, 45vw" alt="" />
        <span class="album-tab-text"><span class="album-tab-no">4집</span><span class="album-tab-name">おやすみのあとで</span></span>
      </button>
      <button type="button" role="tab" class="album-tab" aria-selected="false" data-album-tab="3">
        <ArtImg class="album-tab-art" src="images/covers/album-3.jpg" width={2048} sizes="(min-width: 700px) 48px, 45vw" alt="" />
        <span class="album-tab-text"><span class="album-tab-no">3집</span><span class="album-tab-name">怖いままで</span></span>
