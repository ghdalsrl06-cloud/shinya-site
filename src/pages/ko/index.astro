---
import Base from '../../layouts/Base.astro';
import { coverOf, isReleased } from '../../lib/covers';
import ArtImg from '../../components/ArtImg.astro';
import TokyoClock from '../../components/TokyoClock.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';
import { heroFollow } from '../../lib/presave';

const hf = heroFollow();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = await getCollection('music');
const latest = releases
  .filter((r) => r.data.kind === 'playlist' && isReleased(r))
  .sort((a, b) => (b.data.album ?? 1) - (a.data.album ?? 1))[0] ?? releases[0];
const posts = (await getCollection('blog'))
  .filter((p) => p.id.startsWith('ko/') && !p.data.draft && p.data.date.valueOf() <= Date.now())
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// 첫 업로드가 올라오면 유튜브 영상 ID를 넣어 홈에 노출합니다 (영어 홈과 동일).
const latestVideoId = latest?.data.youtubeId;

const singles = releases
  .filter((r) => r.data.kind !== 'playlist' && isReleased(r))
  .sort((a, b) => (a.data.album ?? 1) - (b.data.album ?? 1) || (a.data.track ?? 99) - (b.data.track ?? 99));
const moods = singles.map((r) => ({
  genre: `${r.data.track}번 트랙`,
  title: `${r.data.title}${r.data.titleKo ? ` — ${r.data.titleKo}` : ''}`,
  desc: r.data.descriptionKo ?? r.data.description,
}));
const lyricLines = singles.map((s) => (s.data.lyrics ?? []).find((l) => l && l.trim())).filter(Boolean);
---

<Base lang="ko" title="SHINYA / 深夜 — 도쿄의 심야 음악" description="자정 이후를 위한 다크 일렉트로닉 J-POP. SHINYA / 深夜의 오리지널 음악.">
  <section class="hero hero-character">
    <ArtImg class="hero-art" src="images/hero-character.jpg" width={2560} sizes="100vw" loading="eager" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-inner">
        <h1 class="jp-title glitch" data-text="深夜">深夜</h1>
        <p class="en-title">Shinya · Tokyo</p>
        <p class="tagline" data-midnight-text={t('ko', 'hero.tagline.midnight')}>{t('ko', 'hero.tagline')}</p>
        {lyricLines.length > 0 && <p class="hero-lyric" data-lyric-lines={JSON.stringify(lyricLines)} aria-hidden="true"></p>}
        <div class="hero-clock"><TokyoClock lang="ko" /></div>
        <p class="hero-cta">
          <a class="btn" href="https://www.youtube.com/@shinyatokyo" target="_blank" rel="noopener">{t('ko', 'btn.youtube')}</a>
          <a class="btn" href={hf.url} target="_blank" rel="noopener">{hf.upcoming ? '프리세이브' : '스트리밍으로 듣기'}</a>
        </p>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[...singles, ...singles].map((r) => (
        <span class="ticker-item">{r.data.title}<span class="ticker-sep">·</span></span>
      ))}
    </div>
  </div>

  <div class="container">
    <section class="section">
      <h2>{t('ko', 'section.mood')}</h2>
      <div class="card mood-card has-art" data-moods={JSON.stringify(moods)}>
        <ArtImg class="card-art" src="images/home/rooftop.jpg" width={1600} sizes="(min-width: 1800px) 1160px, (min-width: 1000px) 920px, 100vw" />
        <div class="card-art-scrim" aria-hidden="true"></div>
        <div class="card-art-content">
          <span class="badge" data-mood-genre>{moods[0].genre}</span>
          <h3 style="margin: 0.8rem 0 0.2rem;" data-mood-title>{moods[0].title}</h3>
          <p class="card-desc" data-mood-desc>{moods[0].desc}</p>
          <p class="mood-note">오늘의 곡은 날짜에 따라 바뀝니다 — <a href={`${base}/ko/music/`}>7곡 믹스 전체 보기</a>.</p>
        </div>
      </div>
    </section>

    {latestVideoId && (
      <section class="section">
        <h2>{t('ko', 'section.video')}</h2>
        <LiteYouTube id={latestVideoId} title="SHINYA" poster={latest ? coverOf(latest) : undefined} />
      </section>
    )}

    <section class="section">
      <h2>스튜디오에서</h2>
      <div class="studio-gallery">
        <a class="studio-card" href={`${base}/ko/music/#album-1`}>
          <ArtImg src="images/home/studio-vocal.jpg" width={1080} sizes="(min-width: 1000px) 30vw, 68vw" />
          <span class="studio-caption">
            <span class="studio-caption-tag">Recording Booth</span>
            <span class="studio-caption-title">자정 넘어 보컬 테이크</span>
          </span>
        </a>
        <a class="studio-card" href={`${base}/ko/music/#album-2`}>
          <ArtImg src="images/home/studio-album2.jpg" width={1080} sizes="(min-width: 1000px) 30vw, 68vw" />
          <span class="studio-caption">
            <span class="studio-caption-tag">2집 세션</span>
            <span class="studio-caption-title">「始発まで」</span>
          </span>
        </a>
        <a class="studio-card" href={`${base}/ko/music/#album-4`}>
          <ArtImg src="images/home/studio-album4.jpg" width={1080} sizes="(min-width: 1000px) 30vw, 68vw" />
          <span class="studio-caption">
            <span class="studio-caption-tag">4집 세션</span>
            <span class="studio-caption-title">「おやすみのあとで」</span>
          </span>
        </a>
      </div>
    </section>

    <section class="section">
      <h2>{t('ko', 'section.latest')}</h2>
      {latest && (
        <div class="card has-art">
          <ArtImg class="card-art" src="images/home/studio.jpg" width={1600} sizes="(min-width: 1800px) 1160px, (min-width: 1000px) 920px, 100vw" />
          <div class="card-art-scrim" aria-hidden="true"></div>
          <div class="card-art-content">
            <span class="badge">{isReleased(latest) ? t('ko', 'badge.new') : t('ko', 'badge.coming')}</span>
            <h3 style="margin: 0.8rem 0 0.2rem;">{latest.data.title}</h3>
            {latest.data.titleKo && <p class="card-title-ja">{latest.data.titleKo}</p>}
            <p class="card-desc">{latest.data.descriptionKo ?? latest.data.description}</p>
          </div>
        </div>
      )}
    </section>

    <section class="section">
      <h2>{t('ko', 'section.blog')}</h2>
      <div class="section-art-panel">
        <ArtImg class="section-art" src="images/home/vending.jpg" width={1600} sizes="(min-width: 1800px) 1160px, (min-width: 1000px) 920px, 100vw" />
        <div class="section-art-scrim" aria-hidden="true"></div>
        <ul class="post-list">
        {posts.map((p) => (
          <li class="card">
            <p class="post-meta">{p.data.date.toISOString().slice(0, 10)}</p>
            <h3 style="margin: 0.3rem 0;">
              <a href={`${base}/ko/blog/${p.id.replace(/^ko\//, '')}/`}>{p.data.title}</a>
            </h3>
            <p class="card-desc">{p.data.description}</p>
          </li>
        ))}
        </ul>
      </div>
    </section>
  </div>
</Base>

<script>
  const initHome = () => {
    const card = document.querySelector('.mood-card');
    if (card) {
      const moods = JSON.parse(card.getAttribute('data-moods'));
      const now = new Date();
      const start = new Date(now.getFullYear(), 0, 0);
      const dayOfYear = Math.floor((now - start) / 86_400_000);
      const mood = moods[dayOfYear % moods.length];
      card.querySelector('[data-mood-genre]').textContent = mood.genre;
      card.querySelector('[data-mood-title]').textContent = mood.title;
      card.querySelector('[data-mood-desc]').textContent = mood.desc;
    }

    const lyricEl = document.querySelector('[data-lyric-lines]');
    if (lyricEl && !lyricEl.dataset.bound) {
      lyricEl.dataset.bound = '1';
      const lines = JSON.parse(lyricEl.getAttribute('data-lyric-lines'));
      let i = Math.floor(Math.random() * lines.length);
      const show = () => {
        if (lyricEl.dataset.locked) return;
        lyricEl.textContent = lines[i % lines.length];
        lyricEl.classList.remove('lyric-glitch');
        void lyricEl.offsetWidth;
        lyricEl.classList.add('lyric-glitch');
        i++;
      };
      show();
      if (window.__shinyaLyricTimer) clearInterval(window.__shinyaLyricTimer);
      window.__shinyaLyricTimer = setInterval(() => {
        if (!document.contains(lyricEl)) { clearInterval(window.__shinyaLyricTimer); return; }
        show();
      }, 5000);
    }
  };
  initHome();
  document.addEventListener('astro:page-load', initHome);
</script>
