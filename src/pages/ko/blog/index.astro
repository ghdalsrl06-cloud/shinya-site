---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t } from '../../../i18n/ui';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog'))
  .filter((p) => p.id.startsWith('ko/') && !p.data.draft && p.data.date.valueOf() <= Date.now())
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tagSlug = (tag: string) => tag.replace(/\s+/g, '-');
---

<Base lang="ko" title="블로그 — SHINYA / 深夜">
  <div class="container">
    <section class="section">
      <h2>블로그</h2>
      <ul class="post-list">
        {posts.map((p) => (
          <li class="card">
            <p class="post-meta">
              {p.data.date.toISOString().slice(0, 10)} · {Math.max(1, Math.round((p.body ?? '').split(/\s+/).length / 130))}{t('ko', 'read.suffix')}
            </p>
            <h3 style="margin: 0.3rem 0;">
              <a href={`${base}/ko/blog/${p.id.replace(/^ko\//, '')}/`}>{p.data.title}</a>
            </h3>
            <p class="card-desc">{p.data.description}</p>
            {p.data.tags.length > 0 && (
              <ul class="tag-list">
                {p.data.tags.map((tag) => (
                  <li><a class="tag" href={`${base}/ko/blog/tag/${tagSlug(tag)}/`}>#{tag}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
