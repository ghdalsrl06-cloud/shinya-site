---
import Base from '../../../layouts/Base.astro';
import ShareRow from '../../../components/ShareRow.astro';
import ArtImg from '../../../components/ArtImg.astro';
import Comments from '../../../components/Comments.astro';
import { getCollection, render } from 'astro:content';
import { t } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((p) => p.id.startsWith('ko/') && !p.data.draft && p.data.date.valueOf() <= Date.now())
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id.replace(/^ko\//, '') },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 130));
const tagSlug = (tag: string) => tag.replace(/\s+/g, '-');
const cover = post.data.cover
  ? post.data.cover.startsWith('http')
    ? post.data.cover
    : `${base}/${post.data.cover.replace(/^\//, '')}`
  : '';
const site = (Astro.site?.href ?? 'https://ghdalsrl06-cloud.github.io/').replace(/\/$/, '');
const postLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'MusicGroup', name: 'SHINYA / 深夜' },
  mainEntityOfPage: `${site}${base}/ko/blog/${post.id.replace(/^(ko|ja)\//, '')}/`,
};
---

<Base lang="ko" title={`${post.data.title} — SHINYA / 深夜`} description={post.data.description} ogImage={post.data.cover}>
  <script type="application/ld+json" set:html={JSON.stringify(postLd)} />
  <div class="container">
    <article class="section prose">
      <a class="back-link" href={`${base}/ko/blog/`}>{t('ko', 'back.blog')}</a>
      <p class="post-meta">{post.data.date.toISOString().slice(0, 10)} · {minutes}{t('ko', 'read.suffix')}</p>
      <h1>{post.data.title}</h1>
      {post.data.cover && (post.data.cover.startsWith('http')
        ? <img class="post-cover" src={cover} alt="" />
        : <ArtImg class="post-cover" src={post.data.cover} width={1280} sizes="(min-width: 900px) 780px, 100vw" />)}
      <Content />
      {post.data.tags.length > 0 && (
        <ul class="tag-list post-tags">
          {post.data.tags.map((tag) => (
            <li><a class="tag" href={`${base}/ko/blog/tag/${tagSlug(tag)}/`}>#{tag}</a></li>
          ))}
        </ul>
      )}
      {(older || newer) && (
        <nav class="post-nav">
          {older ? (
            <a class="post-nav-link" href={`${base}/ko/blog/${older.id.replace(/^ko\//, '')}/`}>
              <span class="post-nav-label">← 이전 글</span>
              <span class="post-nav-title">{older.data.title}</span>
            </a>
          ) : <span />}
          {newer ? (
            <a class="post-nav-link next" href={`${base}/ko/blog/${newer.id.replace(/^ko\//, '')}/`}>
              <span class="post-nav-label">다음 글 →</span>
              <span class="post-nav-title">{newer.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}
      <ShareRow title={`${post.data.title} — SHINYA / 深夜`} lang="ko" />
      <Comments lang="ko" />
    </article>
  </div>
</Base>
