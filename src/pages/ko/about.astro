---
import Base from '../../layouts/Base.astro';

// image에 /public 하위 경로를 넣으면 플레이스홀더 아트가 실제 사진으로 교체됩니다.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const characterImage = 'images/about/character.jpg';
const scenes = [
  {
    cls: 'scene-kissa',
    kanji: '降',
    time: '0:00 AM',
    title: '내려가는 엘리베이터',
    desc: '거울로 둘러싸인 상자, 붉게 떨어지는 층수, 문이 열리면 시작되는 밤 — 毒でいいの의 첫 호흡이 시작되는 곳.',
    image: 'images/about/scene-elevator.jpg',
  },
  {
    cls: 'scene-citypop',
    kanji: '沈',
    time: '1:00 AM',
    title: '네온에 잠긴 욕조',
    desc: '수면 위로 흔들리는 네온, 낮게 울리는 베이스 — 가라앉는 게 아니라 밤에 몸을 맡기는 시간. 夜に溺れて의 방.',
    image: 'images/about/scene-bathtub.jpg',
  },
  {
    cls: 'scene-lofi',
    kanji: '朝',
    time: '5:00 AM',
    title: '아침이 오면 타인',
    desc: '꺼져가는 네온, 창백해지는 하늘, 횡단보도를 반대로 걷는 두 사람 — 朝になれば他人의 마지막 장면. 밤은 여기서 끝난다.',
    image: 'images/about/scene-dawn.jpg',
  },
];
---

<Base lang="ko" title="소개 — SHINYA / 深夜">
  <section class="about-hero">
    <div class="about-hero-art" aria-hidden="true"></div>
    <p class="about-label">About</p>
    <h1 class="about-title">深夜 — SHINYA</h1>
    <p class="about-motto">夜はまだ長い。— 밤은 아직 길다.</p>
  </section>

  <div class="container">
    <section class="section character-section">
      <div class="character-card">
        {characterImage ? (
          <img src={`${base}/${characterImage}`} alt="SHINYA" loading="lazy" />
        ) : (
          <span class="character-kanji" aria-hidden="true">深夜</span>
        )}
        <span class="scene-time">SHINYA</span>
      </div>
      <p class="character-caption">밤을 새우는 사람 — 夜更かしの住人</p>
    </section>

    <section class="section prose about-intro">
      <p>
        SHINYA(深夜, 일본어로 "심야")는 자정 이후의 시간을 위한 다크 일렉트로닉 J-POP 프로젝트입니다 —
        도시가 조용해지고, 네온만 켜져 있고, 모든 것이 조금 더 솔직하게 들리는 그 시간.
        사운드는 세 개의 장면 속에 있습니다:
      </p>
    </section>

    <section class="section scenes">
      {scenes.map((s, i) => (
        <div class={`scene ${i % 2 === 1 ? 'flip' : ''}`}>
          <div class={`scene-visual ${s.cls}`}>
            {s.image ? (
              <img src={`${base}/${s.image}`} alt={s.title} loading="lazy" />
            ) : (
              <span class="scene-kanji" aria-hidden="true">{s.kanji}</span>
            )}
            <span class="scene-time">{s.time}</span>
          </div>
          <div class="scene-text">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        </div>
      ))}
    </section>

    <section class="section prose about-outro">
      <p>
        오리지널 트랙과 롱폼 믹스는 생각할 때, 운전할 때, 일할 때,
        그리고 아직 잠들고 싶지 않은 밤을 위해 만들어집니다.
      </p>
      <p>
        새 음악은 <a href="https://www.youtube.com/@shinyatokyo" target="_blank" rel="noopener">유튜브</a>에
        올라옵니다 — 언제나 자정에.
      </p>
    </section>
  </div>
</Base>
