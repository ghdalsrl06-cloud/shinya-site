---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = await getCollection('music');
const latest = releases[0];
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---

<Base>
  <section class="hero">
    <h1 class="jp-title">深夜</h1>
    <p class="en-title">Shinya · Tokyo</p>
    <p class="tagline">Jazz, city pop &amp; lofi for the hours after midnight.</p>
    <p style="margin-top: 2.5rem;">
      <a class="btn" href="https://www.youtube.com/@shinyatokyo" target="_blank" rel="noopener">YouTube Channel</a>
    </p>
  </section>

  <div class="container">
    <section class="section">
      <h2>Latest</h2>
      {latest && (
        <div class="card">
          <span class="badge">{latest.data.status === 'coming-soon' ? 'Coming Soon' : 'New Release'}</span>
          <h3 style="margin: 0.8rem 0 0.2rem; font-weight: 600;">{latest.data.title}</h3>
          {latest.data.titleJa && <p style="font-family: var(--font-jp); color: var(--text-dim);">{latest.data.titleJa}</p>}
          <p style="color: var(--text-dim); margin-top: 0.6rem;">{latest.data.description}</p>
        </div>
      )}
    </section>

    <section class="section">
      <h2>From the Blog</h2>
      <ul class="post-list">
        {posts.map((p) => (
          <li class="card">
            <p class="post-meta">{p.data.date.toISOString().slice(0, 10)}</p>
            <h3 style="font-weight: 600; margin: 0.3rem 0;">
              <a href={`${base}/blog/${p.id}/`} style="color: var(--text);">{p.data.title}</a>
            </h3>
            <p style="color: var(--text-dim); font-size: 0.95rem;">{p.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
