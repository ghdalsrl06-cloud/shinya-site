---
import Base from '../layouts/Base.astro';
import TokyoClock from '../components/TokyoClock.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = await getCollection('music');
const latest = releases.find((r) => r.data.kind === 'playlist') ?? releases[0];
const posts = (await getCollection('blog'))
  .filter((p) => !p.id.includes('/') && !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Set to a YouTube video ID once the first upload is live to feature it on the home page.
const latestVideoId = '';

const moods = [
  { key: 'overthinking', title: 'The overthinking night', genre: 'Instrumental jazz', desc: 'Thoughts are looping — no lyrics tonight. A quiet trio in an old Tokyo jazz kissa holds the room together while you think.' },
  { key: 'floating', title: 'The floating night', genre: 'City pop', desc: 'Weirdly light, nostalgic, wide awake for no reason. Neon-soaked 80s Japan keeps the feeling glowing. Open a window while it plays.' },
  { key: 'sleepy', title: 'The trying-to-sleep night', genre: 'Slow piano lofi', desc: 'Steady tempo, no swells, a layer of rain. Keep the volume just below listening level and let the night do the rest.' },
  { key: 'reflective', title: 'The closing-the-day night', genre: 'Quiet acoustic voices', desc: 'Journaling, replaying the day — the one time lyrics help. A voice that sounds like it is almost whispering.' },
];
---

<Base>
  <section class="hero">
    <h1 class="jp-title">深夜</h1>
    <p class="en-title">Shinya · Tokyo</p>
    <p class="tagline">Jazz, city pop &amp; lofi for the hours after midnight.</p>
    <div class="hero-clock"><TokyoClock /></div>
    <p class="hero-cta">
      <a class="btn" href="https://www.youtube.com/@shinyatokyo" target="_blank" rel="noopener">YouTube Channel</a>
    </p>
  </section>

  <div class="container">
    <section class="section">
      <h2>Tonight's Mood</h2>
      <div class="card mood-card" data-moods={JSON.stringify(moods)}>
        <span class="badge" data-mood-genre>{moods[0].genre}</span>
        <h3 style="margin: 0.8rem 0 0.2rem;" data-mood-title>{moods[0].title}</h3>
        <p class="card-desc" data-mood-desc>{moods[0].desc}</p>
        <p class="mood-note">Tonight's pick rotates with the date — from <a href={`${base}/blog/music-for-2am/`}>Music for 2AM</a>.</p>
      </div>
    </section>

    {latestVideoId && (
      <section class="section">
        <h2>Latest Video</h2>
        <div class="video-wrap">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${latestVideoId}`}
            title="Latest video"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      </section>
    )}

    <section class="section">
      <h2>Latest</h2>
      {latest && (
        <div class="card">
          <span class="badge">{latest.data.status === 'coming-soon' ? 'Coming Soon' : 'New Release'}</span>
          <h3 style="margin: 0.8rem 0 0.2rem;">{latest.data.title}</h3>
          {latest.data.titleEn && <p class="card-title-ja">{latest.data.titleEn}</p>}
          <p class="card-desc">{latest.data.description}</p>
        </div>
      )}
    </section>

    <section class="section">
      <h2>From the Blog</h2>
      <ul class="post-list">
        {posts.map((p) => (
          <li class="card">
            <p class="post-meta">{p.data.date.toISOString().slice(0, 10)}</p>
            <h3 style="margin: 0.3rem 0;">
              <a href={`${base}/blog/${p.id}/`}>{p.data.title}</a>
            </h3>
            <p class="card-desc">{p.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  // Pick tonight's mood from the visitor's local date (day-of-year), not build time.
  const card = document.querySelector('.mood-card');
  if (card) {
    const moods = JSON.parse(card.getAttribute('data-moods'));
    const now = new Date();
    const start = new Date(now.getFullYear(), 0, 0);
    const dayOfYear = Math.floor((now - start) / 86_400_000);
    const mood = moods[dayOfYear % moods.length];
    card.querySelector('[data-mood-genre]').textContent = mood.genre;
    card.querySelector('[data-mood-title]').textContent = mood.title;
    card.querySelector('[data-mood-desc]').textContent = mood.desc;
  }
</script>
