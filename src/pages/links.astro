---
import Base from '../layouts/Base.astro';
import ArtImg from '../components/ArtImg.astro';
import { HYPERFOLLOW, isOut } from '../lib/presave';

// Set `image` (e.g. `images/character-small.png` under /public) to show a
// small character thumbnail on a link card; empty shows placeholder art.
const streamLinks = HYPERFOLLOW.map((e) => ({
  label: `${isOut(e) ? 'Streaming' : 'Pre-Save'} — ${e.title}`,
  href: e.url,
  note: isOut(e)
    ? 'Listen on Spotify, Apple Music, and every major store'
    : `Streaming release on ${e.dateLabel} — pre-save and it lands in your library at midnight`,
  image: `images/covers/album-${e.n}.jpg`,
}));
const officialLinks = [
  { label: 'Spotify — SHINYA 深夜', href: 'https://open.spotify.com/artist/6pNKFavzsT5AhRLq8Aj9KH', note: 'Follow the artist page — every release in one place', image: 'images/character-thumb.jpg' },
  { label: 'Apple Music — SHINYA 深夜', href: 'https://music.apple.com/kr/artist/shinya-%E6%B7%B1%E5%A4%9C/6800007121', note: 'Verified artist page — every album in full', image: 'images/character-thumb.jpg' },
  { label: 'YouTube Music — SHINYA 深夜', href: 'https://music.youtube.com/@shinyatokyo', note: 'Official artist channel ♪ — albums and tracks in one place', image: 'images/character-thumb.jpg' },
  { label: 'YouTube — SHINYA / 深夜', href: 'https://www.youtube.com/@shinyatokyo', note: 'Original late night music & mixes', image: 'images/character-thumb.jpg' },
  { label: 'Naver Blog (한국어)', href: '#', note: '밤에 듣는 음악 이야기 — 준비 중', image: 'images/character-thumb.jpg' },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolve = (p: string) => (p.startsWith('http') ? p : `${base}/${p.replace(/^\//, '')}`);
---

<Base title="Links — SHINYA / 深夜">
  <div class="container">
    <section class="page-banner">
      <ArtImg class="page-banner-art" src="images/links-banner.jpg" width={1920} sizes="(min-width: 1800px) 1160px, (min-width: 1000px) 920px, 100vw" loading="eager" />
      <div class="page-banner-scrim" aria-hidden="true"></div>
      <div class="page-banner-inner">
        <h1 class="page-banner-title">深夜 LINKS</h1>
        <p class="page-banner-sub">Find SHINYA elsewhere in the night</p>
      </div>
    </section>

    <section class="section" style="max-width: 1000px; margin: 0 auto; padding-bottom: 0;">
      <h2>Official Links</h2>
      <ul class="post-list link-grid">
        {officialLinks.map((l) => (
          <li class="card link-card">
            <a href={l.href} target="_blank" rel="noopener">
              <span class="link-thumb">
                {l.image ? (
                  <img src={resolve(l.image)} alt="" loading="lazy" />
                ) : (
                  <span class="link-thumb-kanji" aria-hidden="true">夜</span>
                )}
              </span>
              <span class="link-body">
                <strong>{l.label}</strong>
                <span class="link-note">{l.note}</span>
              </span>
              <span class="link-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" style="max-width: 1000px; margin: 0 auto;">
      <h2>Streaming · Pre-Save</h2>
      <ul class="post-list link-grid">
        {streamLinks.map((l) => (
          <li class="card link-card">
            <a href={l.href} target="_blank" rel="noopener">
              <span class="link-thumb">
                {l.image ? (
                  <img src={resolve(l.image)} alt="" loading="lazy" />
                ) : (
                  <span class="link-thumb-kanji" aria-hidden="true">夜</span>
                )}
              </span>
              <span class="link-body">
                <strong>{l.label}</strong>
                <span class="link-note">{l.note}</span>
              </span>
              <span class="link-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
