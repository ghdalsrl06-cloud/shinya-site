---
import Base from '../layouts/Base.astro';

const links = [
  { label: 'YouTube — SHINYA / 深夜', href: 'https://www.youtube.com/@shinyatokyo', note: 'Original late night music & mixes' },
  { label: 'Naver Blog (한국어)', href: '#', note: '밤에 듣는 음악 이야기 — 준비 중' },
];
---

<Base title="Links — SHINYA / 深夜">
  <div class="container">
    <section class="section" style="max-width: 560px; margin: 0 auto;">
      <h2>Links</h2>
      <ul class="post-list">
        {links.map((l) => (
          <li class="card">
            <a href={l.href} target="_blank" rel="noopener" style="display: block;">
              <strong style="color: var(--text); font-weight: 500;">{l.label}</strong>
              <span style="display: block; color: var(--text-dim); font-size: 0.85rem; margin-top: 0.2rem;">{l.note}</span>
            </a>
          </li>
        ))}
      </ul>
      <p style="margin-top: 2rem; color: var(--text-dim); font-size: 0.85rem;">
        Spotify / Apple Music links will appear here after the first release.
      </p>
    </section>
  </div>
</Base>
