---
import Base from '../../layouts/Base.astro';
import ArtImg from '../../components/ArtImg.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  const all = (await getCollection('webtoon'))
    .filter((e) => !e.data.draft && e.data.date.valueOf() <= Date.now())
    .sort((a, b) => a.data.episode - b.data.episode);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = 'en';
const heading = entry.data.title ?? entry.data.title;
const note = t(L, 'webtoon.dialogue');
const epLabel = L === 'ko' ? `${entry.data.episode}${t(L, 'webtoon.episode')}`
  : L === 'ja' ? `第${entry.data.episode}${t(L, 'webtoon.episode')}`
  : `${t(L, 'webtoon.episode')} ${entry.data.episode}`;
---

<Base lang="en" title={`${heading} — Webtoon — SHINYA / 深夜`} description={entry.data.description ?? entry.data.description}>
  <div class="container">
    <section class="section webtoon-head">
      <p class="webtoon-no">{epLabel}</p>
      <h1 class="webtoon-heading">{heading}</h1>
      <p class="card-desc">{entry.data.description ?? entry.data.description}</p>
      {note && <p class="webtoon-note">{note}</p>}
    </section>

    <div class="webtoon-strip" data-reader>
      {entry.data.panels.map((p, i) => (
        <ArtImg src={p} width={1080} sizes="(min-width: 900px) 860px, 100vw" alt={`${heading} ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} />
      ))}
    </div>

    <nav class="webtoon-nav">
      {prev ? <a href={`${base}/webtoon/${prev.id}/`}>{t(L, 'webtoon.prev')}</a> : <span></span>}
      <a href={`${base}/webtoon/`}>{t(L, 'webtoon.back')}</a>
      {next ? <a href={`${base}/webtoon/${next.id}/`}>{t(L, 'webtoon.next')}</a> : <span></span>}
    </nav>
  </div>
</Base>
