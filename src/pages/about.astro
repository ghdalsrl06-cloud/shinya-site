---
import Base from '../layouts/Base.astro';
import ArtImg from '../components/ArtImg.astro';
import { CHANNELS } from '../lib/studio';
---

<Base title="About — SHINYA Studio" description="SHINYA Studio: a content studio where AI generates and people direct, and 深夜, the character at the centre of every piece.">
  <section class="about-hero">
    <div class="about-hero-art" aria-hidden="true"></div>
    <p class="about-label">About</p>
    <h1 class="about-title">深夜 — SHINYA STUDIO</h1>
    <p class="about-motto">夜はまだ長い。— The night is still long.</p>
  </section>

  <div class="container">
    <section class="section character-section">
      <div class="character-card">
        <ArtImg src="images/about/character.jpg" width={810} sizes="(min-width: 700px) 420px, 90vw" alt="SHINYA / 深夜" />
        <span class="scene-time">SHINYA</span>
      </div>
      <p class="character-caption">The one who stays up — 夜更かしの住人</p>
    </section>

    <section class="section about-intro">
      <p>
        SHINYA Studio is a content studio where AI generates and people direct. Music videos,
        vertical short dramas, cinematic trailers and the music inside them — one team, from the
        first page of the brief to delivery.
      </p>
      <p>
        深夜 (SHINYA, "late night" in Japanese) is the studio's face: an AI character born in Tokyo
        after midnight, the lead of the first full music video 「今夜も開演」, and the reference every
        piece is measured against.
      </p>
      <p>
        New work lands first on <a href={CHANNELS.music.url} target="_blank" rel="noopener">YouTube · Music</a> and
        <a href={CHANNELS.studio.url} target="_blank" rel="noopener">YouTube · Studio</a>.
      </p>
    </section>
  </div>
</Base>
