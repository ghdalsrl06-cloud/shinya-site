---
import Base from '../layouts/Base.astro';
import { coverOf, isReleased } from '../lib/covers';
import ArtImg from '../components/ArtImg.astro';
import LiteYouTube from '../components/LiteYouTube.astro';
import { getCollection } from 'astro:content';
import { t } from '../i18n/ui';

const releases = await getCollection('music');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site?.href ?? 'https://shinya-music.com/').replace(/\/$/, '');
const playlist = releases.find((r) => r.data.kind === 'playlist' && (r.data.album ?? 1) === 1);
const playlist2 = releases.find((r) => r.data.kind === 'playlist' && r.data.album === 2);
const allSingles = releases.filter((r) => r.data.kind !== 'playlist');
const singles = allSingles.filter((r) => (r.data.album ?? 1) === 1).sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
const singles2 = allSingles.filter((r) => r.data.album === 2).sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
const album2Out = singles2.length > 0 && isReleased(singles2[0]);
const singles3 = allSingles.filter((r) => r.data.album === 3).sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
const album3Out = singles3.length > 0 && isReleased(singles3[0]);
const playlist3 = releases.find((r) => r.data.kind === 'playlist' && r.data.album === 3);
const albumLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  name: 'SHINYA 深夜',
  byArtist: { '@type': 'MusicGroup', name: 'SHINYA / 深夜' },
  numTracks: singles.length,
  track: singles.map((r) => ({
    '@type': 'MusicRecording',
    name: r.data.title,
    position: r.data.track,
    url: `${site}${base}/music/${r.id}/`,
  })),
};
---

<Base title="Music — SHINYA / 深夜">
  <script type="application/ld+json" set:html={JSON.stringify(albumLd)} />
  <div class="container">
    <section class="page-banner">
      <ArtImg class="page-banner-art" src="images/music-banner.jpg" width={1920} sizes="(min-width: 1800px) 1160px, (min-width: 1000px) 920px, 100vw" loading="eager" />
      <div class="page-banner-scrim" aria-hidden="true"></div>
      <div class="page-banner-inner">
        <h1 class="page-banner-title">深夜 MUSIC</h1>
        <p class="page-banner-sub">Dark electronic J-pop · 3 albums · 21 tracks + mixes</p>
      </div>
    </section>


    <div class="album-tabs" role="tablist" aria-label="Albums">
      <button type="button" role="tab" class="album-tab active" aria-selected="true" data-album-tab="3">3rd 「怖いままで」</button>
      <button type="button" role="tab" class="album-tab" aria-selected="false" data-album-tab="2">2nd 「始発まで」</button>
      <button type="button" role="tab" class="album-tab" aria-selected="false" data-album-tab="1">1st 「SHINYA 深夜」</button>
    </div>

    <div data-album-panel="3">
    {singles3.length > 0 && (
      <section class="section">
        <div class="album-head">
          <ArtImg class="album-jacket" src="images/covers/album-3.jpg" width={2048} sizes="(min-width: 700px) 280px, 80vw" alt="怖いままで album cover" />
          <div class="album-head-info">
            <h2>3rd Album 「怖いままで」 — Still Afraid</h2>
            <p class="album-note">{album3Out ? 'Seven songs from 1 AM to 5 AM — a night of being afraid to fall in love again. Out now.' : 'Seven songs from 1 AM to 5 AM — a night of being afraid to fall in love again. Coming soon.'}</p>
          </div>
        </div>
        {playlist3 && (
          <div class="card playlist-card" style="margin-bottom: 1.6rem;">
            <span class="badge">{isReleased(playlist3) ? playlist3.data.releaseDate : t('en', 'badge.coming')}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;">{playlist3.data.title}</h3>
            {playlist3.data.titleEn && <p class="card-title-ja">{playlist3.data.titleEn}</p>}
            <p class="card-desc">{playlist3.data.description}</p>
            {isReleased(playlist3) && playlist3.data.youtubeId ? (
              <div class="card-media" style="margin-top: 1.2rem;">
                <LiteYouTube id={playlist3.data.youtubeId} title={playlist3.data.title} poster={coverOf(playlist3)} />
              </div>
            ) : coverOf(playlist3) && (
              <div class="card-media" style="margin-top: 1.2rem;">
                <ArtImg src={coverOf(playlist3)} width={1280} sizes="(min-width: 1000px) 1100px, 100vw" alt={playlist3.data.title} />
              </div>
            )}
          </div>
        )}
        <div class="card-grid">
          {singles3.map((r) => (
            <div class="card">
              <span class="badge">{isReleased(r) ? r.data.releaseDate : t('en', 'badge.coming')}</span>
              <h3 style="margin: 0.8rem 0 0.1rem;"><a href={`${base}/music/${r.id}/`}>{r.data.title}</a></h3>
              {r.data.titleEn && <p class="card-title-ja">{r.data.titleEn}</p>}
              <p class="card-desc">{r.data.description}</p>
              {isReleased(r) && r.data.youtubeId ? (
                <div class="card-media">
                  <LiteYouTube id={r.data.youtubeId} title={r.data.title} poster={coverOf(r)} />
                </div>
              ) : coverOf(r) && (
                <div class="card-media">
                  <ArtImg src={coverOf(r)} width={1280} sizes="(min-width: 1000px) 300px, 100vw" alt={r.data.title} />
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}
    </div>

    <div data-album-panel="2" hidden>
    {singles2.length > 0 && (
      <section class="section">
        <div class="album-head">
          <ArtImg class="album-jacket" src="images/covers/album-2.jpg" width={2048} sizes="(min-width: 700px) 280px, 80vw" alt="始発まで album cover" />
          <div class="album-head-info">
            <h2>2nd Album 「始発まで」 — Until the First Train</h2>
            <p class="album-note">{album2Out ? 'Seven songs from midnight to the first train — the night after the night ended. Out now.' : 'Seven songs from midnight to the first train — the night after the night ended. Coming soon.'}</p>
          </div>
        </div>
        {playlist2 && (
          <div class="card playlist-card" style="margin-bottom: 1.6rem;">
            <span class="badge">{isReleased(playlist2) ? playlist2.data.releaseDate : t('en', 'badge.coming')}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;">{playlist2.data.title}</h3>
            {playlist2.data.titleEn && <p class="card-title-ja">{playlist2.data.titleEn}</p>}
            <p class="card-desc">{playlist2.data.description}</p>
            {isReleased(playlist2) && playlist2.data.youtubeId ? (
              <div class="card-media" style="margin-top: 1.2rem;">
                <LiteYouTube id={playlist2.data.youtubeId} title={playlist2.data.title} poster={coverOf(playlist2)} />
              </div>
            ) : coverOf(playlist2) && (
              <div class="card-media" style="margin-top: 1.2rem;">
                <ArtImg src={coverOf(playlist2)} width={1280} sizes="(min-width: 1000px) 1100px, 100vw" alt={playlist2.data.title} />
              </div>
            )}
          </div>
        )}
        <div class="card-grid">
          {singles2.map((r) => (
            <div class="card">
              <span class="badge">{isReleased(r) ? r.data.releaseDate : t('en', 'badge.coming')}</span>
              <h3 style="margin: 0.8rem 0 0.1rem;"><a href={`${base}/music/${r.id}/`}>{r.data.title}</a></h3>
              {r.data.titleEn && <p class="card-title-ja">{r.data.titleEn}</p>}
              <p class="card-desc">{r.data.description}</p>
              {isReleased(r) && r.data.youtubeId ? (
                <div class="card-media">
                  <LiteYouTube id={r.data.youtubeId} title={r.data.title} poster={coverOf(r)} />
                </div>
              ) : coverOf(r) && (
                <div class="card-media">
                  <ArtImg src={coverOf(r)} width={1280} sizes="(min-width: 1000px) 300px, 100vw" alt={r.data.title} />
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}
    </div>

    <div data-album-panel="1" hidden>
      <section class="section" style="padding-bottom: 0;">
        <div class="album-head">
          <ArtImg class="album-jacket" src="images/covers/album-1.jpg" width={2048} sizes="(min-width: 700px) 280px, 80vw" alt="SHINYA 深夜 album cover" />
          <div class="album-head-info">
            <h2>1st Album 「SHINYA 深夜」</h2>
            <p class="album-note">Seven tracks for the hours after midnight — the album where the night begins.</p>
          </div>
        </div>
      </section>
    {playlist && (
      <section class="section">
        <h2>{t('en', 'section.playlist')}</h2>
        <div class="card playlist-card">
          <span class="badge">{isReleased(playlist) ? playlist.data.releaseDate : t('en', 'badge.coming')}</span>
          <h3 style="margin: 0.8rem 0 0.1rem;">{playlist.data.title}</h3>
          {playlist.data.titleEn && <p class="card-title-ja">{playlist.data.titleEn}</p>}
          <p class="card-desc">{playlist.data.description}</p>
          {playlist.data.youtubeId && (
            <div style="margin-top: 1.2rem;">
              <LiteYouTube id={playlist.data.youtubeId} title={playlist.data.title} poster={coverOf(playlist)} />
            </div>
          )}
        </div>
      </section>
    )}

    <section class="section">
      <h2>{playlist ? t('en', 'section.singles') : t('en', 'section.discography')}</h2>
      <div class="card-grid">
        {singles.map((r) => (
          <div class="card">
            <span class="badge">{isReleased(r) ? r.data.releaseDate : t('en', 'badge.coming')}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;"><a href={`${base}/music/${r.id}/`}>{r.data.title}</a></h3>
            {r.data.titleEn && <p class="card-title-ja">{r.data.titleEn}</p>}
            <p class="card-desc">{r.data.description}</p>
            {r.data.youtubeId && (
              <div class="card-media">
                <LiteYouTube id={r.data.youtubeId} title={r.data.title} poster={coverOf(r)} />
              </div>
            )}
          </div>
        ))}
      </div>
      <p style="margin-top: 0.8rem;">
        <a href={`${base}/album/`}>One night, seven tracks — read the album story →</a>
      </p>
    </section>
    </div>

      <p style="margin-top: 2.5rem; margin-bottom: 4rem; color: var(--text-dim);">
        {t('en', 'music.subscribe.pre')} <a href="https://www.youtube.com/@shinyatokyo" target="_blank" rel="noopener">YouTube</a> {t('en', 'music.subscribe.post')}
      </p>
  </div>
</Base>

<script>
  const initAlbumTabs = () => {
    const bar = document.querySelector('.album-tabs');
    if (!bar || bar.dataset.bound) return;
    bar.dataset.bound = '1';
    const select = (n) => {
      bar.querySelectorAll('[data-album-tab]').forEach((b) => {
        const on = b.dataset.albumTab === n;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', String(on));
      });
      document.querySelectorAll('[data-album-panel]').forEach((p) => {
        p.hidden = p.dataset.albumPanel !== n;
      });
    };
    bar.addEventListener('click', (e) => {
      const b = e.target.closest('[data-album-tab]');
      if (!b) return;
      select(b.dataset.albumTab);
      history.replaceState(null, '', location.pathname + '#album-' + b.dataset.albumTab);
    });
    const m = location.hash.match(/^#album-([123])$/);
    if (m) select(m[1]);
  };
  initAlbumTabs();
  document.addEventListener('astro:page-load', initAlbumTabs);
</script>
