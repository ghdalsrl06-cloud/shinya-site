---
import Base from '../layouts/Base.astro';
import { coverOf, isReleased } from '../lib/covers';
import ArtImg from '../components/ArtImg.astro';
import LiteYouTube from '../components/LiteYouTube.astro';
import AlbumHead from '../components/AlbumHead.astro';
import MusicOutro from '../components/MusicOutro.astro';
import { getCollection } from 'astro:content';
import { t } from '../i18n/ui';
import { ALBUMS, LINES, jacketOf, tabParts } from '../lib/albums';

const releases = await getCollection('music');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site?.href ?? 'https://shinya-music.com/').replace(/\/$/, '');
const albums = ALBUMS.map((meta) => {
  const mine = (r) => (r.data.album ?? 1) === meta.n;
  const singles = releases
    .filter((r) => r.data.kind !== 'playlist' && mine(r))
    .sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
  return {
    meta,
    singles,
    playlist: releases.find((r) => r.data.kind === 'playlist' && mine(r)),
    out: singles.length > 0 && isReleased(singles[0]),
  };
}).filter((a) => a.singles.length > 0);

// Newest album overall opens the page, and each line lists newest first.
const ordered = [...albums].sort((a, b) => b.meta.n - a.meta.n);
const current = ordered[0].meta.n;
const groups = LINES.map((line) => ({ line, items: ordered.filter((a) => a.meta.line === line.id) }))
  .filter((g) => g.items.length > 0);
// Banner counts come from the data so they cannot fall behind a new album.
const lineAlbums = (id) => albums.filter((a) => a.meta.line === id).length;
const lineTracks = (id) => albums.filter((a) => a.meta.line === id).reduce((n, a) => n + a.singles.length, 0);
const totalTracks = albums.reduce((n, a) => n + a.singles.length, 0);
// Tabs wrap into balanced rows — six albums read better as 3 + 3 than 5 + 1 —
// while each tab keeps the same width whatever the count.
const tabCols = (n) => (n <= 5 ? n : Math.ceil(n / Math.ceil(n / 5)));
// One MusicAlbum per album, so search engines see the whole discography,
// with each recording's running time where the data has it.
const isoDuration = (d) => `PT${Number(d.split(':')[0])}M${Number(d.split(':')[1])}S`;
const albumLd = {
  '@context': 'https://schema.org',
  '@graph': albums.map(({ meta, singles }) => ({
    '@type': 'MusicAlbum',
    name: meta.name,
    byArtist: { '@type': 'MusicGroup', name: 'SHINYA / 深夜' },
    image: `${site}${base}/images/covers/album-${meta.n}.jpg`,
    datePublished: singles[0].data.releaseDate,
    numTracks: singles.length,
    track: singles.map((r) => ({
      '@type': 'MusicRecording',
      name: r.data.title,
      position: r.data.track,
      duration: r.data.duration ? isoDuration(r.data.duration) : undefined,
      url: `${site}${base}/music/${r.id}/`,
    })),
  })),
};---

<Base title="Music — SHINYA / 深夜">
  <script type="application/ld+json" set:html={JSON.stringify(albumLd)} />
  <div class="container">
    <section class="page-banner">
      <ArtImg class="page-banner-art" src="images/music-banner.jpg" width={1920} sizes="(min-width: 1800px) 1160px, (min-width: 1000px) 920px, 100vw" loading="eager" />
      <div class="page-banner-scrim" aria-hidden="true"></div>
      <div class="page-banner-inner">
        <h1 class="page-banner-title" data-title-main="深夜 MUSIC" data-title-club="SHINYA CLUB" data-title-after="SHINYA AFTER">深夜 MUSIC</h1>
        <p class="page-banner-sub" data-sub-main={`Dark electronic J-pop · ${lineAlbums('main')} albums + SHINYA CLUB + AFTER · ${totalTracks} tracks + mixes`} data-sub-after={`Dark R&B line · ${lineTracks('after')} tracks + mixes`} data-sub-club={`Jersey club line · ${lineTracks('club')} tracks + mixes`}>{`Dark electronic J-pop · ${lineAlbums('main')} albums + SHINYA CLUB + AFTER · ${totalTracks} tracks + mixes`}</p>
      </div>
    </section>


{groups.map(({ line, items }) => (
      <>
        <p class="album-line-label">{line.label['en']}</p>
        <div class:list={['album-tabs', items.length <= 2 && 'album-tabs-club']} style={`--tab-cols:${tabCols(items.length)}`} role="tablist" aria-label={line.label['en']}>
          {items.map(({ meta, out }) => (
            <button
              type="button"
              role="tab"
              id={`album-tab-${meta.n}`}
              class:list={['album-tab', meta.n === current && 'active']}
              aria-selected={String(meta.n === current)}
              aria-controls={`album-panel-${meta.n}`}
              tabindex={meta.n === current ? 0 : -1}
              data-album-tab={meta.n}
              data-album-line={meta.line}
            >
              <ArtImg class="album-tab-art" src={jacketOf(meta)} width={2048} sizes="(min-width: 700px) 48px, 45vw" alt="" />
              <span class="album-tab-text"><span class="album-tab-no">{tabParts(meta, 'en').line && <span class="album-tab-line">{tabParts(meta, 'en').line} </span>}{tabParts(meta, 'en').no}{!out && <span class="album-tab-soon">{t('en', 'album.soon')}</span>}</span><span class="album-tab-name">{meta.name}</span></span>
            </button>
          ))}
        </div>
      </>
    ))}

    {ordered.map(({ meta, singles, playlist, out }) => (
      <div data-album-panel={meta.n} id={`album-panel-${meta.n}`} role="tabpanel" aria-labelledby={`album-tab-${meta.n}`} hidden={meta.n !== current}>
        <section class="section" style="padding-bottom: 0;">
          <AlbumHead lang="en" meta={meta} singles={singles} playlist={playlist} out={out} />
        </section>
        {playlist && (
        <section class="section">
          <h2>{t('en', 'section.playlist')}</h2>
          <div class="card playlist-card">
            <span class="badge">{isReleased(playlist) ? playlist.data.releaseDate : t('en', 'badge.coming')}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;">{playlist.data.title}</h3>
            {(playlist.data.titleEn ?? playlist.data.titleJa) && <p class="card-title-ja">{playlist.data.titleEn ?? playlist.data.titleJa}</p>}
            <p class="card-desc">{playlist.data.description}</p>
            {isReleased(playlist) && playlist.data.youtubeId ? (
              <div class="card-media" style="margin-top: 1.2rem;">
                <LiteYouTube id={playlist.data.youtubeId} title={playlist.data.title} poster={coverOf(playlist)} />
              </div>
            ) : coverOf(playlist) && (
              <div class="card-media" style="margin-top: 1.2rem;">
                <ArtImg src={coverOf(playlist)} width={1280} sizes="(min-width: 1000px) 1100px, 100vw" alt={playlist.data.title} />
              </div>
            )}
          </div>
        </section>
        )}
        <section class="section">
          <h2>{t('en', 'section.singles')}</h2>
          <div class="card-grid">
            {singles.map((r) => (
              <div class="card">
            <span class="card-no" aria-hidden="true">{String(r.data.track ?? 0).padStart(2, '0')}</span>
            <span class="badge">{isReleased(r) ? r.data.releaseDate : t('en', 'badge.coming')}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;"><a href={`${base}/music/${r.id}/`}>{r.data.title}</a></h3>
            {(r.data.titleEn ?? r.data.titleJa) && <p class="card-title-ja">{r.data.titleEn ?? r.data.titleJa}</p>}
            <p class="card-desc">{r.data.description}</p>
            {isReleased(r) && r.data.youtubeId ? (
              <div class="card-media">
                <LiteYouTube id={r.data.youtubeId} title={r.data.title} poster={coverOf(r)} />
              </div>
            ) : coverOf(r) && (
              <div class="card-media">
                <ArtImg src={coverOf(r)} width={1280} sizes="(min-width: 1000px) 300px, 100vw" alt={r.data.title} />
              </div>
            )}
              </div>
            ))}
          </div>
          {meta.story && (
          <p style="margin-top: 0.8rem;">
            <a href={`${base}/album/`}>{meta.story['en']}</a>
          </p>
          )}
        </section>
      </div>
    ))}

      <MusicOutro lang="en" />
  </div>
</Base>

<script>
  const initAlbumTabs = () => {
    const bars = Array.from(document.querySelectorAll('.album-tabs'));
    if (!bars.length || bars[0].dataset.bound) return;
    bars[0].dataset.bound = '1';
    const title = document.querySelector('.page-banner-title');
    const sub = document.querySelector('.page-banner-sub');
    const cap = (s) => s[0].toUpperCase() + s.slice(1);
    const select = (n) => {
      // The banner follows whichever line the album belongs to, read off the
      // tab itself, so adding an album never means editing a list of numbers.
      let line = 'main';
      document.querySelectorAll('[data-album-tab]').forEach((b) => {
        const on = b.dataset.albumTab === n;
        if (on) line = b.dataset.albumLine || 'main';
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        // On the mobile strip, bring the chosen tab into view (a no-op on the desktop grid).
        if (on) b.parentElement.scrollLeft = Math.max(0, b.offsetLeft - b.parentElement.offsetLeft - 20);
      });
      document.querySelectorAll('[data-album-panel]').forEach((p) => {
        p.hidden = p.dataset.albumPanel !== n;
      });
      if (sub) sub.textContent = sub.dataset['sub' + cap(line)] || sub.textContent;
      if (title) title.textContent = title.dataset['title' + cap(line)] || title.textContent;
    };
    bars.forEach((bar) => bar.addEventListener('click', (e) => {
      const b = e.target.closest('[data-album-tab]');
      if (!b) return;
      select(b.dataset.albumTab);
      history.replaceState(null, '', location.pathname + '#album-' + b.dataset.albumTab);
    }));
    // Arrow keys move along the tabs of a line; Home and End jump to its ends.
    bars.forEach((bar) => bar.addEventListener('keydown', (e) => {
      const tabs = Array.from(bar.querySelectorAll('[data-album-tab]'));
      const i = tabs.indexOf(document.activeElement);
      if (i < 0) return;
      const step = { ArrowRight: 1, ArrowLeft: -1, Home: -i, End: tabs.length - 1 - i }[e.key];
      if (step === undefined) return;
      e.preventDefault();
      const to = tabs[(i + step + tabs.length) % tabs.length];
      to.focus();
      select(to.dataset.albumTab);
      history.replaceState(null, '', location.pathname + '#album-' + to.dataset.albumTab);
    }));
    const m = location.hash.match(/^#album-(\d+)$/);
    const linked = m && document.querySelector('[data-album-tab="' + m[1] + '"]') ? m[1] : null;
    const active = document.querySelector('[data-album-tab].active');
    select(linked || (active ? active.dataset.albumTab : bars[0].querySelector('[data-album-tab]').dataset.albumTab));
  };
  initAlbumTabs();
  document.addEventListener('astro:page-load', initAlbumTabs);
</script>
