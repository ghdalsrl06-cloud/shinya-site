---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t } from '../i18n/ui';

const releases = await getCollection('music');
const playlist = releases.find((r) => r.data.kind === 'playlist');
const singles = releases.filter((r) => r.data.kind !== 'playlist').sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
---

<Base title="Music — SHINYA / 深夜">
  <div class="container">
    {playlist && (
      <section class="section">
        <h2>{t('en', 'section.playlist')}</h2>
        <div class="card playlist-card">
          <span class="badge">{playlist.data.status === 'coming-soon' ? t('en', 'badge.coming') : playlist.data.releaseDate}</span>
          <h3 style="margin: 0.8rem 0 0.1rem;">{playlist.data.title}</h3>
          {playlist.data.titleEn && <p class="card-title-ja">{playlist.data.titleEn}</p>}
          <p class="card-desc">{playlist.data.description}</p>
          {playlist.data.youtubeId && (
            <div class="video-wrap" style="margin-top: 1.2rem;">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${playlist.data.youtubeId}`}
                title={playlist.data.title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
          )}
        </div>
      </section>
    )}

    <section class="section">
      <h2>{playlist ? t('en', 'section.singles') : t('en', 'section.discography')}</h2>
      <div class="card-grid">
        {singles.map((r) => (
          <div class="card">
            <span class="badge">{r.data.status === 'coming-soon' ? t('en', 'badge.coming') : r.data.releaseDate}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;">{r.data.title}</h3>
            {r.data.titleEn && <p class="card-title-ja">{r.data.titleEn}</p>}
            <p class="card-desc">{r.data.description}</p>
            {r.data.youtubeId && (
              <div class="video-wrap" style="margin-top: 1rem;">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${r.data.youtubeId}`}
                  title={r.data.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              </div>
            )}
          </div>
        ))}
      </div>
      <p style="margin-top: 2.5rem; color: var(--text-dim);">
        {t('en', 'music.subscribe.pre')} <a href="https://www.youtube.com/@shinyatokyo" target="_blank" rel="noopener">YouTube</a> {t('en', 'music.subscribe.post')}
      </p>
    </section>
  </div>
</Base>
