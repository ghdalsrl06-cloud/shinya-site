---
import Base from '../layouts/Base.astro';
import LiteYouTube from '../components/LiteYouTube.astro';
import { getCollection } from 'astro:content';
import { t } from '../i18n/ui';

const releases = await getCollection('music');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site?.href ?? 'https://ghdalsrl06-cloud.github.io/').replace(/\/$/, '');
const playlist = releases.find((r) => r.data.kind === 'playlist');
const singles = releases.filter((r) => r.data.kind !== 'playlist').sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
const albumLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  name: 'SHINYA 深夜',
  byArtist: { '@type': 'MusicGroup', name: 'SHINYA / 深夜' },
  numTracks: singles.length,
  track: singles.map((r) => ({
    '@type': 'MusicRecording',
    name: r.data.title,
    position: r.data.track,
    url: `${site}${base}/music/${r.id}/`,
  })),
};
---

<Base title="Music — SHINYA / 深夜">
  <script type="application/ld+json" set:html={JSON.stringify(albumLd)} />
  <div class="container">
    <section class="page-banner">
      <img class="page-banner-art" src={`${base}/images/music-banner.jpg`} alt="" />
      <div class="page-banner-scrim" aria-hidden="true"></div>
      <div class="page-banner-inner">
        <h1 class="page-banner-title">深夜 MUSIC</h1>
        <p class="page-banner-sub">Dark electronic J-pop · 7 tracks + 60-min mix</p>
      </div>
    </section>

    {playlist && (
      <section class="section">
        <h2>{t('en', 'section.playlist')}</h2>
        <div class="card playlist-card">
          <span class="badge">{playlist.data.status === 'coming-soon' ? t('en', 'badge.coming') : playlist.data.releaseDate}</span>
          <h3 style="margin: 0.8rem 0 0.1rem;">{playlist.data.title}</h3>
          {playlist.data.titleEn && <p class="card-title-ja">{playlist.data.titleEn}</p>}
          <p class="card-desc">{playlist.data.description}</p>
          {playlist.data.youtubeId && (
            <div style="margin-top: 1.2rem;">
              <LiteYouTube id={playlist.data.youtubeId} title={playlist.data.title} poster={playlist.data.poster} />
            </div>
          )}
        </div>
      </section>
    )}

    <section class="section">
      <h2>{playlist ? t('en', 'section.singles') : t('en', 'section.discography')}</h2>
      <div class="card-grid">
        {singles.map((r) => (
          <div class="card">
            <span class="badge">{r.data.status === 'coming-soon' ? t('en', 'badge.coming') : r.data.releaseDate}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;"><a href={`${base}/music/${r.id}/`}>{r.data.title}</a></h3>
            {r.data.titleEn && <p class="card-title-ja">{r.data.titleEn}</p>}
            <p class="card-desc">{r.data.description}</p>
            {r.data.youtubeId && (
              <div style="margin-top: 1rem;">
                <LiteYouTube id={r.data.youtubeId} title={r.data.title} poster={r.data.poster} />
              </div>
            )}
          </div>
        ))}
      </div>
      <p style="margin-top: 2.5rem; color: var(--text-dim);">
        {t('en', 'music.subscribe.pre')} <a href="https://www.youtube.com/@shinyatokyo" target="_blank" rel="noopener">YouTube</a> {t('en', 'music.subscribe.post')}
      </p>
    </section>
  </div>
</Base>
