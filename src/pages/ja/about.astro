---
import Base from '../../layouts/Base.astro';
import ArtImg from '../../components/ArtImg.astro';
import { CHANNELS } from '../../lib/studio';
---

<Base lang="ja" title="アバウト — SHINYA Studio" description="AIが生成し、人が演出するコンテンツスタジオ SHINYA Studio と、すべての作品の中心にいるキャラクター「深夜」。">
  <section class="about-hero">
    <div class="about-hero-art" aria-hidden="true"></div>
    <p class="about-label">About</p>
    <h1 class="about-title">深夜 — SHINYA STUDIO</h1>
    <p class="about-motto">夜はまだ長い。</p>
  </section>

  <div class="container">
    <section class="section character-section">
      <div class="character-card">
        <ArtImg src="images/about/character.jpg" width={810} sizes="(min-width: 700px) 420px, 90vw" alt="SHINYA / 深夜" />
        <span class="scene-time">SHINYA</span>
      </div>
      <p class="character-caption">夜更かしの住人</p>
    </section>

    <section class="section about-intro">
      <p>
        SHINYA Studio は、AIが生成し、人が演出するコンテンツスタジオです。ミュージックビデオ、縦型ショートドラマ、
        シネマティックトレーラー、そしてその中に入る音楽まで — 企画から納品まで一つのチームで行います。
      </p>
      <p>
        深夜（SHINYA）はスタジオの顔です。深夜の東京で生まれたAIキャラクターで、初のフルミュージックビデオ
        「今夜も開演」の主役であり、すべての作品の基準になるキャラクターです。
      </p>
      <p>
        新しい作品は <a href={CHANNELS.music.url} target="_blank" rel="noopener">YouTube · 音楽</a> と
        <a href={CHANNELS.studio.url} target="_blank" rel="noopener">YouTube · スタジオ</a> に先に届きます。
      </p>
    </section>
  </div>
</Base>
