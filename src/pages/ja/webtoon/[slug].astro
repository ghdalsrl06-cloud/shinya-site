---
import Base from '../../../layouts/Base.astro';
import ArtImg from '../../../components/ArtImg.astro';
import { getCollection } from 'astro:content';
import { t } from '../../../i18n/ui';
import { epLabel } from '../../../lib/webtoon';

export async function getStaticPaths() {
  const all = (await getCollection('webtoon'))
    .filter((e) => !e.data.draft && e.data.date.valueOf() <= Date.now())
    .sort((a, b) => a.data.episode - b.data.episode);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = 'ja';
const heading = entry.data.titleJa ?? entry.data.title;
const note = t(L, 'webtoon.dialogue');
---

<Base lang="ja" title={`${heading} — ウェブトゥーン — SHINYA / 深夜`} description={entry.data.descriptionJa ?? entry.data.description}>
  <div class="container">
    <section class="section webtoon-head">
      <p class="webtoon-no">{epLabel(L, entry.data)}</p>
      <h1 class="webtoon-heading">{heading}</h1>
      <p class="card-desc">{entry.data.descriptionJa ?? entry.data.description}</p>
      {note && <p class="webtoon-note">{note}</p>}
    </section>

    <div class="webtoon-strip" data-reader>
      {entry.data.panels.map((p, i) => (
        <ArtImg src={p} width={1080} sizes="(min-width: 900px) 860px, 100vw" alt={`${heading} ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} />
      ))}
    </div>

    <nav class="webtoon-nav">
      {prev ? <a href={`${base}/ja/webtoon/${prev.id}/`}>{t(L, 'webtoon.prev')}</a> : <span></span>}
      <a href={`${base}/ja/webtoon/`}>{t(L, 'webtoon.back')}</a>
      {next ? <a href={`${base}/ja/webtoon/${next.id}/`}>{t(L, 'webtoon.next')}</a> : <span></span>}
    </nav>
  </div>
</Base>
