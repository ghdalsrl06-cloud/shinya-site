      <button type="button" role="tab" class="album-tab" aria-selected="false" data-album-tab="1">
        <ArtImg class="album-tab-art" src="images/covers/album-1.jpg" width={2048} sizes="(min-width: 700px) 48px, 45vw" alt="" />
