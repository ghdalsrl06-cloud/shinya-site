          {playlist.data.titleJa && <p class="card-title-ja">{playlist.data.titleJa}</p>}
          <p class="card-desc">{playlist.data.descriptionJa ?? playlist.data.description}</p>
          {playlist.data.youtubeId && (
            <div style="margin-top: 1.2rem;">
              <LiteYouTube id={playlist.data.youtubeId} title={playlist.data.title} poster={coverOf(playlist)} />
            </div>
          )}
        </div>
      </section>
    )}

    <section class="section">
      <h2>{playlist ? t('ja', 'section.singles') : t('ja', 'section.discography')}</h2>
      <div class="card-grid">
        {singles.map((r) => (
          <div class="card">
            <span class="badge">{isReleased(r) ? r.data.releaseDate : t('ja', 'badge.coming')}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;"><a href={`${base}/ja/music/${r.id}/`}>{r.data.title}</a></h3>
            {r.data.titleJa && <p class="card-title-ja">{r.data.titleJa}</p>}
            <p class="card-desc">{r.data.descriptionJa ?? r.data.description}</p>
            {r.data.youtubeId && (
              <div class="card-media">
                <LiteYouTube id={r.data.youtubeId} title={r.data.title} poster={coverOf(r)} />
              </div>
            )}
          </div>
        ))}
      </div>
      <p style="margin-top: 0.8rem;">
        <a href={`${base}/ja/album/`}>ひと晩、7曲 — アルバムストーリーを読む →</a>
      </p>
    </section>
    </div>

      <p style="margin-top: 2.5rem; margin-bottom: 4rem; color: var(--text-dim);">
        {t('ja', 'music.subscribe.pre')}
        <a href="https://www.youtube.com/@shinyatokyo" target="_blank" rel="noopener">YouTube</a>{t('ja', 'music.subscribe.post')}
      </p>
  </div>
</Base>

<script>
  const initAlbumTabs = () => {
    const bars = Array.from(document.querySelectorAll('.album-tabs'));
    if (!bars.length || bars[0].dataset.bound) return;
    bars[0].dataset.bound = '1';
    const select = (n) => {
      document.querySelectorAll('[data-album-tab]').forEach((b) => {
        const on = b.dataset.albumTab === n;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', String(on));
      });
      document.querySelectorAll('[data-album-panel]').forEach((p) => {
        p.hidden = p.dataset.albumPanel !== n;
      });
      const sub = document.querySelector('.page-banner-sub');
      if (sub) sub.textContent = n === '6' ? sub.dataset.subClub : sub.dataset.subMain;
      const title = document.querySelector('.page-banner-title');
      if (title) title.textContent = n === '6' ? title.dataset.titleClub : title.dataset.titleMain;
    };
    bars.forEach((bar) => bar.addEventListener('click', (e) => {
      const b = e.target.closest('[data-album-tab]');
      if (!b) return;
      select(b.dataset.albumTab);
      history.replaceState(null, '', location.pathname + '#album-' + b.dataset.albumTab);
    }));
    const m = location.hash.match(/^#album-([1-6])$/);
    const active = document.querySelector('[data-album-tab].active');
    select(m ? m[1] : (active ? active.dataset.albumTab : '6'));
  };
  initAlbumTabs();
  document.addEventListener('astro:page-load', initAlbumTabs);
</script>
