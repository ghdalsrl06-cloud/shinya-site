---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';

const releases = await getCollection('music');
---

<Base lang="ja" title="ミュージック — SHINYA / 深夜">
  <div class="container">
    <section class="section">
      <h2>{t('ja', 'section.discography')}</h2>
      <div class="card-grid">
        {releases.map((r) => (
          <div class="card">
            <span class="badge">{r.data.status === 'coming-soon' ? t('ja', 'badge.coming') : r.data.releaseDate}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;">{r.data.title}</h3>
            {r.data.titleJa && <p class="card-title-ja">{r.data.titleJa}</p>}
            <p class="card-desc">{r.data.description}</p>
            {r.data.youtubeId && (
              <div class="video-wrap" style="margin-top: 1rem;">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${r.data.youtubeId}`}
                  title={r.data.title}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              </div>
            )}
          </div>
        ))}
      </div>
      <p style="margin-top: 2.5rem; color: var(--text-dim);">
        {t('ja', 'music.subscribe.pre')}
        <a href="https://www.youtube.com/@shinyatokyo" target="_blank" rel="noopener">YouTube</a>{t('ja', 'music.subscribe.post')}
      </p>
    </section>
  </div>
</Base>
