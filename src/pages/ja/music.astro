---
import Base from '../../layouts/Base.astro';
import { coverOf, isReleased } from '../../lib/covers';
import ArtImg from '../../components/ArtImg.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import AlbumHead from '../../components/AlbumHead.astro';
import MusicOutro from '../../components/MusicOutro.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';
import { ALBUMS, LINES, jacketOf } from '../../lib/albums';

const releases = await getCollection('music');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site?.href ?? 'https://shinya-music.com/').replace(/\/$/, '');
const albums = ALBUMS.map((meta) => {
  const mine = (r) => (r.data.album ?? 1) === meta.n;
  const singles = releases
    .filter((r) => r.data.kind !== 'playlist' && mine(r))
    .sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
  return {
    meta,
    singles,
    playlist: releases.find((r) => r.data.kind === 'playlist' && mine(r)),
    out: singles.length > 0 && isReleased(singles[0]),
  };
}).filter((a) => a.singles.length > 0);

// Newest album overall opens the page, and the grid lists newest first.
const ordered = [...albums].sort((a, b) => b.meta.n - a.meta.n);
const current = ordered[0].meta.n;
// Banner counts come from the data so they cannot fall behind a new album.
const lineAlbums = (id) => albums.filter((a) => a.meta.line === id).length;
const lineTracks = (id) => albums.filter((a) => a.meta.line === id).reduce((n, a) => n + a.singles.length, 0);
const totalTracks = albums.reduce((n, a) => n + a.singles.length, 0);
// Release day as M/D, for the badge on the jacket of an album not out yet.
const dateBadge = (r) => {
  const d = r?.data.releaseDate;
  return d ? `${Number(d.slice(5, 7))}/${Number(d.slice(8, 10))}` : '';
};
// One MusicAlbum per album, so search engines see the whole discography,
// with each recording's running time where the data has it.
const isoDuration = (d) => `PT${Number(d.split(':')[0])}M${Number(d.split(':')[1])}S`;
const albumLd = {
  '@context': 'https://schema.org',
  '@graph': albums.map(({ meta, singles }) => ({
    '@type': 'MusicAlbum',
    name: meta.name,
    byArtist: { '@type': 'MusicGroup', name: 'SHINYA / 深夜' },
    image: `${site}${base}/images/covers/album-${meta.n}.jpg`,
    datePublished: singles[0].data.releaseDate,
    numTracks: singles.length,
    track: singles.map((r) => ({
      '@type': 'MusicRecording',
      name: r.data.title,
      position: r.data.track,
      duration: r.data.duration ? isoDuration(r.data.duration) : undefined,
      url: `${site}${base}/ja/music/${r.id}/`,
    })),
  })),
};---

<Base lang="ja" title="ミュージック — SHINYA / 深夜">
  <script type="application/ld+json" set:html={JSON.stringify(albumLd)} />
  <div class="container">
    <section class="page-banner">
      <ArtImg class="page-banner-art" src="images/music-banner.jpg" width={1920} sizes="(min-width: 1800px) 1160px, (min-width: 1000px) 920px, 100vw" loading="eager" />
      <div class="page-banner-scrim" aria-hidden="true"></div>
      <div class="page-banner-inner">
        <h1 class="page-banner-title" data-title-main="深夜 MUSIC" data-title-club="SHINYA CLUB" data-title-after="SHINYA AFTER">深夜 MUSIC</h1>
        <p class="page-banner-sub" data-sub-main={`ダークエレクトロニックJ-POP ${lineAlbums('main')}枚 + SHINYA CLUB + AFTER · 全${totalTracks}曲 + ミックス`} data-sub-after={`ダークR&Bライン · 全${lineTracks('after')}曲 + ミックス`} data-sub-club={`ジャージークラブライン · 全${lineTracks('club')}曲 + ミックス`}>{`ダークエレクトロニックJ-POP ${lineAlbums('main')}枚 + SHINYA CLUB + AFTER · 全${totalTracks}曲 + ミックス`}</p>
      </div>
    </section>


<div class="album-filter" role="group" aria-label={t('ja', 'album.all')}>
      <button type="button" class="album-filter-btn active" data-album-filter="all" aria-pressed="true">{t('ja', 'album.all')} <b>{albums.length}</b></button>
      {LINES.filter((l) => lineAlbums(l.id) > 0).map((l) => (
        <button type="button" class="album-filter-btn" data-album-filter={l.id} aria-pressed="false">{l.short} <b>{lineAlbums(l.id)}</b></button>
      ))}
    </div>
    <div class="album-grid" role="tablist" aria-label={t('ja', 'album.all')}>
      {ordered.map(({ meta, singles, out }) => (
        <button
          type="button"
          role="tab"
          id={`album-tab-${meta.n}`}
          class:list={['album-tile', meta.n === current && 'active', !out && 'soon']}
          aria-selected={String(meta.n === current)}
          aria-controls={`album-panel-${meta.n}`}
          tabindex={meta.n === current ? 0 : -1}
          data-album-tab={meta.n}
          data-album-line={meta.line}
        >
          <span class="album-tile-art">
            <ArtImg src={jacketOf(meta)} width={2048} sizes="(min-width: 700px) 150px, 30vw" alt="" />
            {!out && <span class="album-tile-date">{dateBadge(singles[0])}</span>}
          </span>
          <span class="album-tile-no" data-line={meta.line}>{meta.tabNo['ja']}</span>
          <span class="album-tile-name">{meta.name}</span>
        </button>
      ))}
    </div>

    {ordered.map(({ meta, singles, playlist, out }) => (
      <div data-album-panel={meta.n} id={`album-panel-${meta.n}`} role="tabpanel" aria-labelledby={`album-tab-${meta.n}`} hidden={meta.n !== current}>
        <section class="section" style="padding-bottom: 0;">
          <AlbumHead lang="ja" meta={meta} singles={singles} playlist={playlist} out={out} />
        </section>
        {playlist && (
        <section class="section">
          <h2>{t('ja', 'section.playlist')}</h2>
          <div class="card playlist-card">
            <span class="badge">{isReleased(playlist) ? playlist.data.releaseDate : t('ja', 'badge.coming')}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;">{playlist.data.title}</h3>
            {(playlist.data.titleJa) && <p class="card-title-ja">{playlist.data.titleJa}</p>}
            <p class="card-desc">{playlist.data.descriptionJa ?? playlist.data.description}</p>
            {isReleased(playlist) && playlist.data.youtubeId ? (
              <div class="card-media" style="margin-top: 1.2rem;">
                <LiteYouTube id={playlist.data.youtubeId} title={playlist.data.title} poster={coverOf(playlist)} />
              </div>
            ) : coverOf(playlist) && (
              <div class="card-media" style="margin-top: 1.2rem;">
                <ArtImg src={coverOf(playlist)} width={1280} sizes="(min-width: 1000px) 1100px, 100vw" alt={playlist.data.title} />
              </div>
            )}
          </div>
        </section>
        )}
        <section class="section">
          <h2>{t('ja', 'section.singles')}</h2>
          <div class="card-grid">
            {singles.map((r) => (
              <div class="card">
            <span class="card-no" aria-hidden="true">{String(r.data.track ?? 0).padStart(2, '0')}</span>
            <span class="badge">{isReleased(r) ? r.data.releaseDate : t('ja', 'badge.coming')}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;"><a href={`${base}/ja/music/${r.id}/`}>{r.data.title}</a></h3>
            {(r.data.titleJa) && <p class="card-title-ja">{r.data.titleJa}</p>}
            <p class="card-desc">{r.data.descriptionJa ?? r.data.description}</p>
            {isReleased(r) && r.data.youtubeId ? (
              <div class="card-media">
                <LiteYouTube id={r.data.youtubeId} title={r.data.title} poster={coverOf(r)} />
              </div>
            ) : coverOf(r) && (
              <div class="card-media">
                <ArtImg src={coverOf(r)} width={1280} sizes="(min-width: 1000px) 300px, 100vw" alt={r.data.title} />
              </div>
            )}
              </div>
            ))}
          </div>
          {meta.story && (
          <p style="margin-top: 0.8rem;">
            <a href={`${base}/ja/album/`}>{meta.story['ja']}</a>
          </p>
          )}
        </section>
      </div>
    ))}

      <MusicOutro lang="ja" />
  </div>
</Base>

<script>
  const initAlbumTabs = () => {
    const grid = document.querySelector('.album-grid');
    if (!grid || grid.dataset.bound) return;
    grid.dataset.bound = '1';
    const title = document.querySelector('.page-banner-title');
    const sub = document.querySelector('.page-banner-sub');
    const cap = (s) => s[0].toUpperCase() + s.slice(1);
    const tiles = Array.from(grid.querySelectorAll('[data-album-tab]'));
    const select = (n) => {
      // The banner follows whichever line the album belongs to, read off the
      // tile itself, so adding an album never means editing a list of numbers.
      let line = 'main';
      tiles.forEach((b) => {
        const on = b.dataset.albumTab === n;
        if (on) line = b.dataset.albumLine || 'main';
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
      });
      document.querySelectorAll('[data-album-panel]').forEach((p) => {
        p.hidden = p.dataset.albumPanel !== n;
      });
      if (sub) sub.textContent = sub.dataset['sub' + cap(line)] || sub.textContent;
      if (title) title.textContent = title.dataset['title' + cap(line)] || title.textContent;
    };
    const go = (b) => {
      select(b.dataset.albumTab);
      history.replaceState(null, '', location.pathname + '#album-' + b.dataset.albumTab);
    };
    grid.addEventListener('click', (e) => {
      const b = e.target.closest('[data-album-tab]');
      if (b) go(b);
    });
    // Arrow keys move across the tiles on show; Home and End jump to the ends.
    grid.addEventListener('keydown', (e) => {
      const shown = tiles.filter((b) => !b.hidden);
      const i = shown.indexOf(document.activeElement);
      if (i < 0) return;
      const step = { ArrowRight: 1, ArrowLeft: -1, Home: -i, End: shown.length - 1 - i }[e.key];
      if (step === undefined) return;
      e.preventDefault();
      const to = shown[(i + step + shown.length) % shown.length];
      to.focus();
      go(to);
    });
    // The line chips only narrow the grid; the open album stays open.
    const chips = Array.from(document.querySelectorAll('[data-album-filter]'));
    chips.forEach((chip) => chip.addEventListener('click', () => {
      const f = chip.dataset.albumFilter;
      chips.forEach((c) => {
        c.classList.toggle('active', c === chip);
        c.setAttribute('aria-pressed', String(c === chip));
      });
      tiles.forEach((b) => { b.hidden = f !== 'all' && b.dataset.albumLine !== f; });
    }));
    const m = location.hash.match(/^#album-(\d+)$/);
    const linked = m && tiles.some((b) => b.dataset.albumTab === m[1]) ? m[1] : null;
    const active = tiles.find((b) => b.classList.contains('active'));
    select(linked || (active ? active.dataset.albumTab : tiles[0].dataset.albumTab));
  };
  initAlbumTabs();
  document.addEventListener('astro:page-load', initAlbumTabs);
</script>
