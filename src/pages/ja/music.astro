---
import Base from '../../layouts/Base.astro';
import { coverOf, isReleased } from '../../lib/covers';
import ArtImg from '../../components/ArtImg.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';

const releases = await getCollection('music');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site?.href ?? 'https://shinya-music.com/').replace(/\/$/, '');
const playlist = releases.find((r) => r.data.kind === 'playlist' && (r.data.album ?? 1) === 1);
const playlist2 = releases.find((r) => r.data.kind === 'playlist' && r.data.album === 2);
const allSingles = releases.filter((r) => r.data.kind !== 'playlist');
const singles = allSingles.filter((r) => (r.data.album ?? 1) === 1).sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
const singles2 = allSingles.filter((r) => r.data.album === 2).sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
const album2Out = singles2.length > 0 && isReleased(singles2[0]);
const singles3 = allSingles.filter((r) => r.data.album === 3).sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
const album3Out = singles3.length > 0 && isReleased(singles3[0]);
const playlist3 = releases.find((r) => r.data.kind === 'playlist' && r.data.album === 3);
const singles4 = allSingles.filter((r) => r.data.album === 4).sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
const album4Out = singles4.length > 0 && isReleased(singles4[0]);
const playlist4 = releases.find((r) => r.data.kind === 'playlist' && r.data.album === 4);
const singles5 = allSingles.filter((r) => r.data.album === 5).sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
const album5Out = singles5.length > 0 && isReleased(singles5[0]);
const playlist5 = releases.find((r) => r.data.kind === 'playlist' && r.data.album === 5);
const singles6 = allSingles.filter((r) => r.data.album === 6).sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
const album6Out = singles6.length > 0 && isReleased(singles6[0]);
const playlist6 = releases.find((r) => r.data.kind === 'playlist' && r.data.album === 6);
const albumLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  name: 'SHINYA 深夜',
  byArtist: { '@type': 'MusicGroup', name: 'SHINYA / 深夜' },
  numTracks: singles.length,
  track: singles.map((r) => ({
    '@type': 'MusicRecording',
    name: r.data.title,
    position: r.data.track,
    url: `${site}${base}/ja/music/${r.id}/`,
  })),
};
---

<Base lang="ja" title="ミュージック — SHINYA / 深夜">
  <script type="application/ld+json" set:html={JSON.stringify(albumLd)} />
  <div class="container">
    <section class="page-banner">
      <ArtImg class="page-banner-art" src="images/music-banner.jpg" width={1920} sizes="(min-width: 1800px) 1160px, (min-width: 1000px) 920px, 100vw" loading="eager" />
      <div class="page-banner-scrim" aria-hidden="true"></div>
      <div class="page-banner-inner">
        <h1 class="page-banner-title" data-title-main="深夜 MUSIC" data-title-club="SHINYA CLUB">深夜 MUSIC</h1>
        <p class="page-banner-sub" data-sub-main="ダークエレクトロニックJ-POP 5枚 + SHINYA CLUB · 全43曲 + ミックス" data-sub-club="ジャージークラブライン · 全7曲 + ミックス">ダークエレクトロニックJ-POP 5枚 + SHINYA CLUB · 全43曲 + ミックス</p>
      </div>
    </section>


    <p class="album-line-label">SHINYA CLUB — ジャージークラブ</p>
    <div class="album-tabs album-tabs-club" role="tablist" aria-label="SHINYA CLUB">
      <button type="button" role="tab" class="album-tab active" aria-selected="true" data-album-tab="6">
        <ArtImg class="album-tab-art" src="images/covers/album-6.jpg" width={2048} sizes="48px" alt="" />
        <span class="album-tab-text"><span class="album-tab-no">CLUB 1st</span><span class="album-tab-name">Paper Luck</span></span>
      </button>
    </div>

    <p class="album-line-label">SHINYA 深夜 — ダークエレクトロニック</p>
    <div class="album-tabs" role="tablist" aria-label="アルバム">
      <button type="button" role="tab" class="album-tab" aria-selected="false" data-album-tab="5">
        <ArtImg class="album-tab-art" src="images/covers/album-5.jpg" width={2048} sizes="(min-width: 700px) 48px, 45vw" alt="" />
        <span class="album-tab-text"><span class="album-tab-no">5th</span><span class="album-tab-name">誰かの部屋で</span></span>
      </button>
      <button type="button" role="tab" class="album-tab" aria-selected="false" data-album-tab="4">
        <ArtImg class="album-tab-art" src="images/covers/album-4.jpg" width={2048} sizes="(min-width: 700px) 48px, 45vw" alt="" />
        <span class="album-tab-text"><span class="album-tab-no">4th</span><span class="album-tab-name">おやすみのあとで</span></span>
      </button>
      <button type="button" role="tab" class="album-tab" aria-selected="false" data-album-tab="3">
        <ArtImg class="album-tab-art" src="images/covers/album-3.jpg" width={2048} sizes="(min-width: 700px) 48px, 45vw" alt="" />
