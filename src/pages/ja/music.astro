                </div>
              )}
            </div>
          ))}
        </div>
      </section>
      </>
    )}
    </div>

    <div data-album-panel="4" hidden>
    {singles4.length > 0 && (
      <>
      <section class="section" style="padding-bottom: 0;">
        <div class="album-head">
          <ArtImg class="album-jacket" src="images/covers/album-4.jpg" width={2048} sizes="(min-width: 700px) 280px, 80vw" alt="おやすみのあとで アルバムジャケット" />
