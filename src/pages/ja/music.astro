        <ArtImg class="album-tab-art" src="images/covers/album-2.jpg" width={2048} sizes="(min-width: 700px) 48px, 45vw" alt="" />
        <span class="album-tab-text"><span class="album-tab-no">2nd</span><span class="album-tab-name">始発まで</span></span>
