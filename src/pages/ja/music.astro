---
import Base from '../../layouts/Base.astro';
import { coverOf } from '../../lib/covers';
import ArtImg from '../../components/ArtImg.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';

const releases = await getCollection('music');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site?.href ?? 'https://shinya-music.com/').replace(/\/$/, '');
const playlist = releases.find((r) => r.data.kind === 'playlist' && (r.data.album ?? 1) === 1);
const playlist2 = releases.find((r) => r.data.kind === 'playlist' && r.data.album === 2);
const allSingles = releases.filter((r) => r.data.kind !== 'playlist');
const singles = allSingles.filter((r) => (r.data.album ?? 1) === 1).sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
const singles2 = allSingles.filter((r) => r.data.album === 2).sort((a, b) => (a.data.track ?? 99) - (b.data.track ?? 99));
const albumLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  name: 'SHINYA 深夜',
  byArtist: { '@type': 'MusicGroup', name: 'SHINYA / 深夜' },
  numTracks: singles.length,
  track: singles.map((r) => ({
    '@type': 'MusicRecording',
    name: r.data.title,
    position: r.data.track,
    url: `${site}${base}/ja/music/${r.id}/`,
  })),
};
---

<Base lang="ja" title="ミュージック — SHINYA / 深夜">
  <script type="application/ld+json" set:html={JSON.stringify(albumLd)} />
  <div class="container">
    <section class="page-banner">
      <ArtImg class="page-banner-art" src="images/music-banner.jpg" width={1920} sizes="(min-width: 1800px) 1160px, (min-width: 1000px) 920px, 100vw" loading="eager" />
      <div class="page-banner-scrim" aria-hidden="true"></div>
      <div class="page-banner-inner">
        <h1 class="page-banner-title">深夜 MUSIC</h1>
        <p class="page-banner-sub">ダークエレクトロニックJ-POP · 全7曲 + 60分ミックス</p>
      </div>
    </section>


    {singles2.length > 0 && (
      <section class="section">
        <h2>2nd Album 「始発まで」</h2>
        <p class="album-note">午前0時から始発まで、眠れないひと晩の7曲 — カミングスーン。歌詞は先に読めます。</p>
        {playlist2 && (
          <div class="card playlist-card" style="margin-bottom: 1.6rem;">
            <span class="badge">{playlist2.data.status === 'coming-soon' ? t('ja', 'badge.coming') : playlist2.data.releaseDate}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;">{playlist2.data.title}</h3>
            {playlist2.data.titleJa && <p class="card-title-ja">{playlist2.data.titleJa}</p>}
            <p class="card-desc">{playlist2.data.descriptionJa ?? playlist2.data.description}</p>
            {playlist2.data.youtubeId ? (
              <div style="margin-top: 1.2rem;">
                <LiteYouTube id={playlist2.data.youtubeId} title={playlist2.data.title} poster={coverOf(playlist2)} />
              </div>
            ) : coverOf(playlist2) && (
              <div style="margin-top: 1.2rem;">
                <ArtImg src={coverOf(playlist2)} width={1280} sizes="(min-width: 1000px) 820px, 100vw" alt={playlist2.data.title} />
              </div>
            )}
          </div>
        )}
        <div class="card-grid">
          {singles2.map((r) => (
            <div class="card">
              <span class="badge">{t('ja', 'badge.coming')}</span>
              <h3 style="margin: 0.8rem 0 0.1rem;"><a href={`${base}/ja/music/${r.id}/`}>{r.data.title}</a></h3>
              {r.data.titleJa && <p class="card-title-ja">{r.data.titleJa}</p>}
              <p class="card-desc">{r.data.descriptionJa ?? r.data.description}</p>
              {coverOf(r) && (
                <div style="margin-top: 1rem;">
                  <ArtImg src={coverOf(r)} width={1280} sizes="(min-width: 1000px) 300px, 100vw" alt={r.data.title} />
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {playlist && (
      <section class="section">
        <h2>{t('ja', 'section.playlist')}</h2>
        <div class="card playlist-card">
          <span class="badge">{playlist.data.status === 'coming-soon' ? t('ja', 'badge.coming') : playlist.data.releaseDate}</span>
          <h3 style="margin: 0.8rem 0 0.1rem;">{playlist.data.title}</h3>
          {playlist.data.titleJa && <p class="card-title-ja">{playlist.data.titleJa}</p>}
          <p class="card-desc">{playlist.data.descriptionJa ?? playlist.data.description}</p>
          {playlist.data.youtubeId && (
            <div style="margin-top: 1.2rem;">
              <LiteYouTube id={playlist.data.youtubeId} title={playlist.data.title} poster={coverOf(playlist)} />
            </div>
          )}
        </div>
      </section>
    )}

    <section class="section">
      <h2>{playlist ? t('ja', 'section.singles') : t('ja', 'section.discography')}</h2>
      <div class="card-grid">
        {singles.map((r) => (
          <div class="card">
            <span class="badge">{r.data.status === 'coming-soon' ? t('ja', 'badge.coming') : r.data.releaseDate}</span>
            <h3 style="margin: 0.8rem 0 0.1rem;"><a href={`${base}/ja/music/${r.id}/`}>{r.data.title}</a></h3>
            {r.data.titleJa && <p class="card-title-ja">{r.data.titleJa}</p>}
            <p class="card-desc">{r.data.descriptionJa ?? r.data.description}</p>
            {r.data.youtubeId && (
              <div style="margin-top: 1rem;">
                <LiteYouTube id={r.data.youtubeId} title={r.data.title} poster={coverOf(r)} />
              </div>
            )}
          </div>
        ))}
      </div>
      <p style="margin-top: 2.5rem; color: var(--text-dim);">
        {t('ja', 'music.subscribe.pre')}
        <a href="https://www.youtube.com/@shinyatokyo" target="_blank" rel="noopener">YouTube</a>{t('ja', 'music.subscribe.post')}
      </p>
      <p style="margin-top: 0.8rem;">
        <a href={`${base}/ja/album/`}>ひと晩、7曲 — アルバムストーリーを読む →</a>
      </p>
    </section>
  </div>
</Base>
