---
import Base from '../../layouts/Base.astro';
import TokyoClock from '../../components/TokyoClock.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = await getCollection('music');
const latest = releases[0];
const posts = (await getCollection('blog'))
  .filter((p) => p.id.startsWith('ja/'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// 最初の動画が公開されたら、YouTube動画IDを入れてホームに表示します(英語ホームと同じ)。
const latestVideoId = '';

const moods = [
  { key: 'overthinking', title: '考えすぎる夜', genre: 'インストゥルメンタル・ジャズ', desc: '思考がループする夜、歌詞はノイズに言葉を足すだけ。古い東京のジャズ喫茶で流れるような静かなトリオが、部屋の空気を支えながら思考を流してくれます。' },
  { key: 'floating', title: '浮かぶ夜', genre: 'シティポップ', desc: '理由もなく軽くて、妙に懐かしくて、目が冴えている夜。ネオンに濡れた80年代日本のサウンドが、その気分を沈ませず光らせ続けます。窓を開けて聴いてみてください。' },
  { key: 'sleepy', title: '眠りたい夜', genre: 'スローピアノ・ローファイ', desc: '一定のテンポ、盛り上がりのない展開、雨音をひとつ重ねて。音量は「聴く」より少し下げて — あとは夜に任せましょう。' },
  { key: 'reflective', title: '一日を閉じる夜', genre: '静かなアコースティック・ボイス', desc: '日記を書いたり、一日を巻き戻したりする時間 — 歌詞が助けになる唯一の夜。ささやくように歌う声は、音楽というより友達に近い。' },
];
---

<Base lang="ja" title="SHINYA / 深夜 — 東京発、深夜の音楽" description="真夜中過ぎのためのジャズ、シティポップ、ローファイ。SHINYA / 深夜のオリジナル音楽。">
  <section class="hero">
    <h1 class="jp-title">深夜</h1>
    <p class="en-title">Shinya · Tokyo</p>
    <p class="tagline">{t('ja', 'hero.tagline')}</p>
    <div class="hero-clock"><TokyoClock lang="ja" /></div>
    <p class="hero-cta">
      <a class="btn" href="https://www.youtube.com/@shinyatokyo" target="_blank" rel="noopener">{t('ja', 'btn.youtube')}</a>
    </p>
  </section>

  <div class="container">
    <section class="section">
      <h2>{t('ja', 'section.mood')}</h2>
      <div class="card mood-card" data-moods={JSON.stringify(moods)}>
        <span class="badge" data-mood-genre>{moods[0].genre}</span>
        <h3 style="margin: 0.8rem 0 0.2rem;" data-mood-title>{moods[0].title}</h3>
        <p class="card-desc" data-mood-desc>{moods[0].desc}</p>
        <p class="mood-note">{t('ja', 'mood.note')} <a href={`${base}/ja/blog/music-for-2am/`}>午前2時の音楽</a>.</p>
      </div>
    </section>

    {latestVideoId && (
      <section class="section">
        <h2>{t('ja', 'section.video')}</h2>
        <div class="video-wrap">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${latestVideoId}`}
            title="最新動画"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      </section>
    )}

    <section class="section">
      <h2>{t('ja', 'section.latest')}</h2>
      {latest && (
        <div class="card">
          <span class="badge">{latest.data.status === 'coming-soon' ? t('ja', 'badge.coming') : t('ja', 'badge.new')}</span>
          <h3 style="margin: 0.8rem 0 0.2rem;">{latest.data.title}</h3>
          {latest.data.titleJa && <p class="card-title-ja">{latest.data.titleJa}</p>}
          <p class="card-desc">{latest.data.description}</p>
        </div>
      )}
    </section>

    <section class="section">
      <h2>{t('ja', 'section.blog')}</h2>
      <ul class="post-list">
        {posts.map((p) => (
          <li class="card">
            <p class="post-meta">{p.data.date.toISOString().slice(0, 10)}</p>
            <h3 style="margin: 0.3rem 0;">
              <a href={`${base}/ja/blog/${p.id.replace(/^ja\//, '')}/`}>{p.data.title}</a>
            </h3>
            <p class="card-desc">{p.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  // 訪問者のローカル日付(年間通算日)で今夜のムードを選びます。
  const card = document.querySelector('.mood-card');
  if (card) {
    const moods = JSON.parse(card.getAttribute('data-moods'));
    const now = new Date();
    const start = new Date(now.getFullYear(), 0, 0);
    const dayOfYear = Math.floor((now - start) / 86_400_000);
    const mood = moods[dayOfYear % moods.length];
    card.querySelector('[data-mood-genre]').textContent = mood.genre;
    card.querySelector('[data-mood-title]').textContent = mood.title;
    card.querySelector('[data-mood-desc]').textContent = mood.desc;
  }
</script>
