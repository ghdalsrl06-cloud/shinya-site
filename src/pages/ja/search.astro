---
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base lang="ja" title="検索 — SHINYA / 深夜" description="曲、歌詞、ブログ記事を検索。">
  <div class="container">
    <section class="section search-page" data-pagefind-ignore>
      <h2>検索</h2>
      <p class="search-note">曲名、歌詞の一節、ブログ記事を検索できます。</p>
      <div id="search"></div>
    </section>
  </div>
</Base>

<link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
<script is:inline src={`${base}/pagefind/pagefind-ui.js`}></script>
<script is:inline data-astro-rerun define:vars={{ base }}>
  if (window.PagefindUI && document.getElementById('search')?.childElementCount === 0) {
    new window.PagefindUI({
      element: '#search',
      bundlePath: `${base}/pagefind/`,
      showSubResults: true,
      showImages: false,
      translations: {
        placeholder: 'キーワードを入力',
        clear_search: 'クリア',
        load_more: 'さらに表示',
        zero_results: '「[SEARCH_TERM]」に一致する結果はありません',
        many_results: '「[SEARCH_TERM]」の検索結果 [COUNT]件',
        one_result: '「[SEARCH_TERM]」の検索結果 [COUNT]件',
        searching: '「[SEARCH_TERM]」を検索中...',
      },
    });
  }
</script>
