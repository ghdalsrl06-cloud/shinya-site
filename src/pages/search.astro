---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Search — SHINYA / 深夜" description="Search songs, lyrics, and blog posts.">
  <div class="container">
    <section class="section search-page" data-pagefind-ignore>
      <h2>Search</h2>
      <p class="search-note">Search song titles, a line of lyrics, or blog posts.</p>
      <div id="search"></div>
    </section>
  </div>
</Base>

<link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
<script is:inline src={`${base}/pagefind/pagefind-ui.js`}></script>
<script is:inline data-astro-rerun define:vars={{ base }}>
  if (window.PagefindUI && document.getElementById('search')?.childElementCount === 0) {
    new window.PagefindUI({
      element: '#search',
      bundlePath: `${base}/pagefind/`,
      showSubResults: true,
      showImages: false,
    });
  }
</script>
