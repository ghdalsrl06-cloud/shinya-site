---
import Base from '../layouts/Base.astro';
import '../styles/original.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="404 — SHINYA Studio" description="Page not found." localized={false}>
  <section class="hero notfound">
    <div class="hero-inner">
      <p class="hero-loc">404 · Not found</p>
      <h1 class="hero-name">Lights off<em>.</em></h1>
      <p class="hero-line">There is nothing on this page.</p>
      <p class="hero-sub">The address may have changed, or the episode is not up yet.</p>
      <p class="hero-cta">
        <a class="btn btn-primary" href={`${base}/`}>Back home</a>
      </p>
    </div>
  </section>
</Base>
