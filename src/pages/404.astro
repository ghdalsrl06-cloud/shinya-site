---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="404 — SHINYA / 深夜" description="Page not found.">
  <section class="hero hero-character notfound">
    <img class="hero-art" src={`${base}/images/about/scene-dawn.jpg`} alt="" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-inner">
      <h1 class="jp-title glitch" data-text="迷子">迷子</h1>
      <p class="en-title">404 · Not Found</p>
      <p class="tagline">夜に迷いましたね — you got lost in the night.<br />The page you were looking for isn't here.</p>
      <p class="hero-cta">
        <a class="btn" href={`${base}/`}>Back Home</a>
      </p>
    </div>
  </section>
</Base>
