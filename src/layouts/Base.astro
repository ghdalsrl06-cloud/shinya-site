---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { t, type Lang } from '../i18n/ui';
import { CHANNELS, STORES } from '../lib/studio';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
  // False for pages that exist in one language only (404). Their language
  // switcher points at the locale home instead of a translated path that was
  // never built, and they advertise no hreflang alternates.
  localized?: boolean;
}

const {
  title = 'After Bedtime — 셋 재우고',
  description = 'The hobby channel of a father of three: the things he wanted in his teens and twenties, made after the kids are asleep as AI dramas, animation and music videos.',
  lang = 'en',
  ogImage: ogImageProp,
  localized = true,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'en' ? '' : `/${lang}`;
const current = Astro.url.pathname;
// The home's four sections, named in English in every language, as the
// channel sections are. ORIGINAL owns the series pages.
const home = `${base}${prefix}/`;
const links = [
  { href: `${home}#about`, label: 'ABOUT', active: false },
  { href: `${home}#original`, label: 'EPISODES', active: current.startsWith(`${home}series/`) },
  { href: `${home}#channels`, label: 'CHANNELS', active: false },
  { href: `${home}#collab`, label: 'COLLAB', active: false },
];
const localeMatch = current.slice(base.length).match(/^\/(ko|ja)(\/|$)/);
const rest = localeMatch ? current.slice(base.length + 3) : current.slice(base.length);
const urlFor = (l: Lang) =>
  `${base}${l === 'en' ? '' : `/${l}`}${localized ? rest || '/' : '/'}`;
const site = (Astro.site?.href ?? 'https://shinya-music.com/').replace(/\/$/, '');
const canonical = `${site}${current}`;
const altUrl = (l: Lang) => `${site}${urlFor(l)}`;
const ogImage = ogImageProp
  ? ogImageProp.startsWith('http')
    ? ogImageProp
    : `${site}${base}/${ogImageProp.replace(/^\//, '')}`
  : `${site}${base}/images/og.png`;
const isDefaultOg = !ogImageProp;
const studioLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t(lang, 'brand.mark'),
  alternateName: 'After Bedtime',
  url: `${site}${base}/`,
  logo: `${site}${base}/images/og.png`,
  sameAs: [CHANNELS.studio.url, CHANNELS.music.url],
};
// 무료 방문자 통계(GoatCounter): https://www.goatcounter.com 의 사이트 코드.
const GOATCOUNTER_CODE = 'shinya';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0d0b" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="canonical" href={canonical} />
    {localized && <link rel="alternate" hreflang="en" href={altUrl('en')} />}
    {localized && <link rel="alternate" hreflang="ko" href={altUrl('ko')} />}
    {localized && <link rel="alternate" hreflang="ja" href={altUrl('ja')} />}
    {localized && <link rel="alternate" hreflang="x-default" href={altUrl('en')} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {isDefaultOg && <meta property="og:image:width" content="1200" />}
    {isDefaultOg && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%230f0d0b'/%3E%3Ccircle cx='50' cy='42' r='21' fill='%23ffb547'/%3E%3Ccircle cx='30' cy='80' r='6' fill='%23f1eadf'/%3E%3Ccircle cx='50' cy='80' r='6' fill='%23f1eadf'/%3E%3Ccircle cx='70' cy='80' r='6' fill='%23f1eadf'/%3E%3C/svg%3E" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(studioLd)} />
    <ClientRouter />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="bg-glow" aria-hidden="true"></div>
    <nav class="site-nav">
      <div class="inner">
        <a href={`${base}${prefix}/`} class="brand"><span class="mark">{t(lang, 'brand.mark')}</span><span class="en">{t(lang, 'brand.sub')}</span></a>
        <div class="nav-right">
          <ul class="nav-links">
            {links.map((l) => (
              <li><a href={l.href} class={l.active ? 'active' : ''}>{l.label}</a></li>
            ))}
          </ul>
          <div class="lang-switch" aria-label="Language">
            <a href={urlFor('en')} class={lang === 'en' ? 'active' : ''} lang="en">EN</a>
            <span aria-hidden="true">·</span>
            <a href={urlFor('ko')} class={lang === 'ko' ? 'active' : ''} lang="ko">한국어</a>
            <span aria-hidden="true">·</span>
            <a href={urlFor('ja')} class={lang === 'ja' ? 'active' : ''} lang="ja">日本語</a>
          </div>
          <a class="btn btn-primary nav-cta" href={`${CHANNELS.studio.url}?sub_confirmation=1`} target="_blank" rel="noopener">{t(lang, 'nav.subscribe')}</a>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href={`${base}${prefix}/`} class="brand"><span class="mark">{t(lang, 'brand.mark')}</span><span class="en">{t(lang, 'brand.sub')}</span></a>
          <p>{t(lang, 'footer.tagline')}</p>
          <p class="footer-motto">夜はまだ長い</p>
        </div>
        <div class="footer-col">
          <h4>{t(lang, 'footer.channels')}</h4>
          <ul>
            <li><a href={CHANNELS.studio.url} target="_blank" rel="noopener">{t(lang, 'footer.ytMain')}</a></li>
            <li><a href={CHANNELS.music.url} target="_blank" rel="noopener">{t(lang, 'footer.ytMusic')}</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>{t(lang, 'footer.stores')}</h4>
          <ul>
            {STORES.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h4>{t(lang, 'footer.site')}</h4>
          <ul>
            {links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>{t(lang, 'footer.copy')}</p>
        <p><a href={urlFor('en')} lang="en">EN</a> · <a href={urlFor('ko')} lang="ko">한국어</a> · <a href={urlFor('ja')} lang="ja">日本語</a></p>
      </div>
    </footer>
    <script>
      // Site-wide behaviour, re-initialized on every client-side navigation.
      // GoatCounter: count client-side navigations too (initial load counts itself).
      let firstLoad = true;
      const countView = () => {
        if (firstLoad) { firstLoad = false; return; }
        window.goatcounter?.count?.({ path: location.pathname });
      };

      const initAll = () => { countView(); };
      initAll();
      document.addEventListener('astro:page-load', initAll);
    </script>
    {GOATCOUNTER_CODE && (
      <script
        is:inline
        data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </body>
</html>
