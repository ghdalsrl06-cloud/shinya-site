---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import NightSky from '../components/NightSky.astro';
import { t, type Lang } from '../i18n/ui';
import { CHANNELS, STORES } from '../lib/studio';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
  // False for pages that exist in one language only (404). Their language
  // switcher points at the locale home instead of a translated path that was
  // never built, and they advertise no hreflang alternates.
  localized?: boolean;
}

const {
  title = 'SHINYA Studio — AI music videos, short dramas, trailers & original music | 深夜',
  description = 'AI content studio: music videos, short dramas, trailers and original music — generated with AI, directed by people. Home of SHINYA / 深夜.',
  lang = 'en',
  ogImage: ogImageProp,
  localized = true,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'en' ? '' : `/${lang}`;
const current = Astro.url.pathname;
// Three anchors on the home, then the about page. The brand mark is the way home.
const links = [
  { href: `${base}${prefix}/#services`, label: t(lang, 'nav.services') },
  { href: `${base}${prefix}/#works`, label: t(lang, 'nav.works') },
  { href: `${base}${prefix}/#process`, label: t(lang, 'nav.process') },
  { href: `${base}${prefix}/about/`, label: t(lang, 'nav.about') },
];
const isActive = (href: string) => !href.includes('#') && current.startsWith(href);
const localeMatch = current.slice(base.length).match(/^\/(ko|ja)(\/|$)/);
const rest = localeMatch ? current.slice(base.length + 3) : current.slice(base.length);
const urlFor = (l: Lang) =>
  `${base}${l === 'en' ? '' : `/${l}`}${localized ? rest || '/' : '/'}`;
const site = (Astro.site?.href ?? 'https://shinya-music.com/').replace(/\/$/, '');
const canonical = `${site}${current}`;
const altUrl = (l: Lang) => `${site}${urlFor(l)}`;
const ogImage = ogImageProp
  ? ogImageProp.startsWith('http')
    ? ogImageProp
    : `${site}${base}/${ogImageProp.replace(/^\//, '')}`
  : `${site}${base}/images/og.png`;
const isDefaultOg = !ogImageProp;
const studioLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SHINYA Studio',
  alternateName: '深夜',
  url: `${site}${base}/`,
  logo: `${site}${base}/images/og.png`,
  sameAs: [CHANNELS.studio.url, CHANNELS.music.url],
  brand: { '@type': 'Brand', name: 'SHINYA / 深夜' },
};
const artistLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'SHINYA',
  alternateName: '深夜',
  url: `${site}${base}/`,
  sameAs: [CHANNELS.music.url, ...STORES.map((s) => s.url)],
};
// 무료 방문자 통계(GoatCounter): https://www.goatcounter.com 에서 가입 후
// 사이트 코드(예: 'shinya')를 아래에 넣으면 활성화됩니다.
const GOATCOUNTER_CODE = 'shinya';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="canonical" href={canonical} />
    {localized && <link rel="alternate" hreflang="en" href={altUrl('en')} />}
    {localized && <link rel="alternate" hreflang="ko" href={altUrl('ko')} />}
    {localized && <link rel="alternate" hreflang="ja" href={altUrl('ja')} />}
    {localized && <link rel="alternate" hreflang="x-default" href={altUrl('en')} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {isDefaultOg && <meta property="og:image:width" content="1200" />}
    {isDefaultOg && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='0.9em' font-size='80' fill='%23ff2d6e'%3E%E5%A4%9C%3C/text%3E%3C/svg%3E" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(studioLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(artistLd)} />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <script is:inline data-astro-rerun>
      // 深夜 mode: after midnight (visitor's local time, 00:00-04:59) the
      // whole palette inverts to blood-red. Preview any time with ?midnight=1;
      // the nav toggle stores a manual override in localStorage.
      (function () {
        var p = new URLSearchParams(location.search);
        var stored = null;
        try { stored = localStorage.getItem('shinya-midnight'); } catch (e) {}
        var h = new Date().getHours();
        var on = p.has('midnight')
          ? p.get('midnight') !== '0'
          : stored !== null
            ? stored === '1'
            : h >= 0 && h < 5;
        document.documentElement.classList.toggle('midnight-mode', on);
      })();
    </script>
    <div class="bg-glow" aria-hidden="true"></div>
    <NightSky />
    <nav class="site-nav">
      <div class="inner">
        <a href={`${base}${prefix}/`} class="brand"><span class="jp">深夜</span><span class="en">Shinya Studio</span></a>
        <div class="nav-right">
          <ul class="nav-links">
            {links.map((l) => (
              <li><a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a></li>
            ))}
          </ul>
          <button class="midnight-toggle" type="button" data-midnight-toggle aria-pressed="false" title="深夜 MODE">深夜</button>
          <span class="midnight-flag" aria-hidden="true">深夜 MODE</span>
          <div class="lang-switch" aria-label="Language">
            <a href={urlFor('en')} class={lang === 'en' ? 'active' : ''} lang="en">EN</a>
            <span aria-hidden="true">·</span>
            <a href={urlFor('ko')} class={lang === 'ko' ? 'active' : ''} lang="ko">한국어</a>
            <span aria-hidden="true">·</span>
            <a href={urlFor('ja')} class={lang === 'ja' ? 'active' : ''} lang="ja">日本語</a>
          </div>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href={`${base}${prefix}/`} class="brand"><span class="jp">深夜</span><span class="en">Shinya Studio</span></a>
          <p>{t(lang, 'footer.tagline')}</p>
          <p class="footer-motto">夜はまだ長い</p>
        </div>
        <div class="footer-col">
          <h4>{t(lang, 'footer.channels')}</h4>
          <ul>
            <li><a href={CHANNELS.music.url} target="_blank" rel="noopener">{t(lang, 'footer.ytMusic')}</a></li>
            <li><a href={CHANNELS.studio.url} target="_blank" rel="noopener">{t(lang, 'footer.ytStudio')}</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>{t(lang, 'footer.stores')}</h4>
          <ul>
            {STORES.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>{t(lang, 'footer.copy')}</p>
        <p><a href={urlFor('en')} lang="en">EN</a> · <a href={urlFor('ko')} lang="ko">한국어</a> · <a href={urlFor('ja')} lang="ja">日本語</a></p>
      </div>
    </footer>
    <script>
      // Site-wide behaviour, re-initialized on every client-side navigation.
      const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Hero parallax: art drifts with the pointer and slides with scroll.
      let heroArt = null;
      let mx = 0, my = 0, sy = 0, rafId = 0;
      const findHero = () => { heroArt = reduced() ? null : document.querySelector('.hero-character .hero-art'); };
      const applyParallax = () => {
        rafId = 0;
        if (!heroArt) return;
        heroArt.style.transform = `scale(1.07) translate3d(${mx * 16}px, ${my * 10 + sy}px, 0)`;
      };
      const queue = () => { if (!rafId) rafId = requestAnimationFrame(applyParallax); };
      addEventListener('mousemove', (e) => {
        if (!heroArt) return;
        mx = e.clientX / innerWidth - 0.5;
        my = e.clientY / innerHeight - 0.5;
        queue();
      }, { passive: true });
      addEventListener('scroll', () => {
        if (!heroArt) return;
        const hero = heroArt.closest('.hero-character');
        if (!hero) return;
        sy = Math.max(0, -hero.getBoundingClientRect().top) * 0.16;
        queue();
      }, { passive: true });

      // 深夜 mode: entry flash, tab chrome, and the manual toggle in the nav.
      const isMidnight = () => document.documentElement.classList.contains('midnight-mode');
      const triggerFlicker = () => {
        if (reduced()) return;
        document.documentElement.classList.add('midnight-flicker');
        setTimeout(() => document.documentElement.classList.remove('midnight-flicker'), 800);
      };
      const FAVICON = (color) => `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='0.9em' font-size='80' fill='%23${color}'%3E%E5%A4%9C%3C/text%3E%3C/svg%3E`;
      const applyMidnightChrome = () => {
        const on = isMidnight();
        const link = document.querySelector("link[rel='icon']");
        if (link) link.href = FAVICON(on ? 'ff2444' : 'ff2d6e');
        const plain = document.title.replace(/^【深夜】 /, '');
        document.title = on ? `【深夜】 ${plain}` : plain;
      };
      const setMidnight = (on, flicker = true) => {
        document.documentElement.classList.toggle('midnight-mode', on);
        try { localStorage.setItem('shinya-midnight', on ? '1' : '0'); } catch {}
        if (on && flicker) triggerFlicker();
        document.querySelector('[data-midnight-toggle]')?.setAttribute('aria-pressed', String(on));
        applyMidnightChrome();
        dispatchEvent(new CustomEvent('shinya:midnight', { detail: { on } }));
      };
      const initMidnightToggle = () => {
        const btn = document.querySelector('[data-midnight-toggle]');
        if (!btn || btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.setAttribute('aria-pressed', String(isMidnight()));
        btn.addEventListener('click', () => setMidnight(!isMidnight()));
      };
      // Flash once per session when the site loads already in 深夜 mode.
      const initMidnightEntry = () => {
        if (!isMidnight()) return;
        try {
          if (sessionStorage.getItem('shinya-mflash')) return;
          sessionStorage.setItem('shinya-mflash', '1');
        } catch { return; }
        triggerFlicker();
      };

      // GoatCounter: count client-side navigations too (initial load counts itself).
      let firstLoad = true;
      const countView = () => {
        if (firstLoad) { firstLoad = false; return; }
        window.goatcounter?.count?.({ path: location.pathname });
      };

      const initAll = () => { findHero(); initMidnightToggle(); initMidnightEntry(); applyMidnightChrome(); countView(); };
      initAll();
      document.addEventListener('astro:page-load', initAll);
    </script>
    {GOATCOUNTER_CODE && (
      <script
        is:inline
        data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </body>
</html>
