---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import NightSky from '../components/NightSky.astro';
import { t, type Lang } from '../i18n/ui';
import { CHANNELS, STORES } from '../lib/studio';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
  // False for pages that exist in one language only (404). Their language
  // switcher points at the locale home instead of a translated path that was
  // never built, and they advertise no hreflang alternates.
  localized?: boolean;
}

const {
  title = 'SHINYA Studio — AI original series & music | 深夜',
  description = 'AI content studio: original series and music — generated with AI, directed by people. Home of SHINYA / 深夜.',
  lang = 'en',
  ogImage: ogImageProp,
  localized = true,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'en' ? '' : `/${lang}`;
const current = Astro.url.pathname;
// The home's four sections, named in English in every language, as the
// channel sections are. ORIGINAL owns the series pages.
const home = `${base}${prefix}/`;
const links = [
  { href: `${home}#about`, label: 'ABOUT', active: false },
  { href: `${home}#original`, label: 'ORIGINAL', active: current.startsWith(`${home}series/`) },
  { href: `${home}#channels`, label: 'CHANNELS', active: false },
  { href: `${home}#collab`, label: 'COLLAB', active: false },
];
const localeMatch = current.slice(base.length).match(/^\/(ko|ja)(\/|$)/);
const rest = localeMatch ? current.slice(base.length + 3) : current.slice(base.length);
const urlFor = (l: Lang) =>
  `${base}${l === 'en' ? '' : `/${l}`}${localized ? rest || '/' : '/'}`;
const site = (Astro.site?.href ?? 'https://shinya-music.com/').replace(/\/$/, '');
const canonical = `${site}${current}`;
const altUrl = (l: Lang) => `${site}${urlFor(l)}`;
const ogImage = ogImageProp
  ? ogImageProp.startsWith('http')
    ? ogImageProp
    : `${site}${base}/${ogImageProp.replace(/^\//, '')}`
  : `${site}${base}/images/og.png`;
const isDefaultOg = !ogImageProp;
const studioLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SHINYA Studio',
  alternateName: '深夜',
  url: `${site}${base}/`,
  logo: `${site}${base}/images/og.png`,
  sameAs: [CHANNELS.studio.url, CHANNELS.music.url],
  brand: { '@type': 'Brand', name: 'SHINYA / 深夜' },
};
const artistLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'SHINYA',
  alternateName: '深夜',
  url: `${site}${base}/`,
  sameAs: [CHANNELS.music.url, ...STORES.map((s) => s.url)],
};
// 무료 방문자 통계(GoatCounter): https://www.goatcounter.com 에서 가입 후
// 사이트 코드(예: 'shinya')를 아래에 넣으면 활성화됩니다.
const GOATCOUNTER_CODE = 'shinya';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070d" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="canonical" href={canonical} />
    {localized && <link rel="alternate" hreflang="en" href={altUrl('en')} />}
    {localized && <link rel="alternate" hreflang="ko" href={altUrl('ko')} />}
    {localized && <link rel="alternate" hreflang="ja" href={altUrl('ja')} />}
    {localized && <link rel="alternate" hreflang="x-default" href={altUrl('en')} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {isDefaultOg && <meta property="og:image:width" content="1200" />}
    {isDefaultOg && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='0.9em' font-size='80' fill='%23ff2d6e'%3E%E5%A4%9C%3C/text%3E%3C/svg%3E" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(studioLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(artistLd)} />
    <ClientRouter />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="bg-glow" aria-hidden="true"></div>
    <NightSky />
    <nav class="site-nav">
      <div class="inner">
        <a href={`${base}${prefix}/`} class="brand"><span class="jp">深夜</span><span class="en">Shinya Studio</span></a>
        <div class="nav-right">
          <ul class="nav-links">
            {links.map((l) => (
              <li><a href={l.href} class={l.active ? 'active' : ''}>{l.label}</a></li>
            ))}
          </ul>
          <div class="lang-switch" aria-label="Language">
            <a href={urlFor('en')} class={lang === 'en' ? 'active' : ''} lang="en">EN</a>
            <span aria-hidden="true">·</span>
            <a href={urlFor('ko')} class={lang === 'ko' ? 'active' : ''} lang="ko">한국어</a>
            <span aria-hidden="true">·</span>
            <a href={urlFor('ja')} class={lang === 'ja' ? 'active' : ''} lang="ja">日本語</a>
          </div>
          <a class="btn btn-primary nav-cta" href={`${CHANNELS.studio.url}?sub_confirmation=1`} target="_blank" rel="noopener">{t(lang, 'nav.subscribe')}</a>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href={`${base}${prefix}/`} class="brand"><span class="jp">深夜</span><span class="en">Shinya Studio</span></a>
          <p>{t(lang, 'footer.tagline')}</p>
          <p class="footer-motto">夜はまだ長い</p>
        </div>
        <div class="footer-col">
          <h4>{t(lang, 'footer.channels')}</h4>
          <ul>
            <li><a href={CHANNELS.music.url} target="_blank" rel="noopener">{t(lang, 'footer.ytMusic')}</a></li>
            <li><a href={CHANNELS.studio.url} target="_blank" rel="noopener">{t(lang, 'footer.ytStudio')}</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>{t(lang, 'footer.stores')}</h4>
          <ul>
            {STORES.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h4>{t(lang, 'footer.site')}</h4>
          <ul>
            {links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>{t(lang, 'footer.copy')}</p>
        <p><a href={urlFor('en')} lang="en">EN</a> · <a href={urlFor('ko')} lang="ko">한국어</a> · <a href={urlFor('ja')} lang="ja">日本語</a></p>
      </div>
    </footer>
    <script>
      // Site-wide behaviour, re-initialized on every client-side navigation.
      const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Hero parallax: art drifts with the pointer and slides with scroll.
      let heroArt = null;
      let mx = 0, my = 0, sy = 0, rafId = 0;
      const findHero = () => { heroArt = reduced() ? null : document.querySelector('.hero-character .hero-art'); };
      const applyParallax = () => {
        rafId = 0;
        if (!heroArt) return;
        heroArt.style.transform = `scale(1.07) translate3d(${mx * 16}px, ${my * 10 + sy}px, 0)`;
      };
      const queue = () => { if (!rafId) rafId = requestAnimationFrame(applyParallax); };
      addEventListener('mousemove', (e) => {
        if (!heroArt) return;
        mx = e.clientX / innerWidth - 0.5;
        my = e.clientY / innerHeight - 0.5;
        queue();
      }, { passive: true });
      addEventListener('scroll', () => {
        if (!heroArt) return;
        const hero = heroArt.closest('.hero-character');
        if (!hero) return;
        sy = Math.max(0, -hero.getBoundingClientRect().top) * 0.16;
        queue();
      }, { passive: true });

      // GoatCounter: count client-side navigations too (initial load counts itself).
      let firstLoad = true;
      const countView = () => {
        if (firstLoad) { firstLoad = false; return; }
        window.goatcounter?.count?.({ path: location.pathname });
      };

      const initAll = () => { findHero(); countView(); };
      initAll();
      document.addEventListener('astro:page-load', initAll);
    </script>
    {GOATCOUNTER_CODE && (
      <script
        is:inline
        data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </body>
</html>
