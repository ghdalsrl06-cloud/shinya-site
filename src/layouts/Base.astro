---
import '../styles/global.css';
import NightSky from '../components/NightSky.astro';
import RainToggle from '../components/RainToggle.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const { title = 'SHINYA / 深夜 — Late Night Music from Tokyo', description = 'Jazz, city pop and lofi for the late night. Original music by SHINYA / 深夜.', lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'en' ? '' : `/${lang}`;
const current = Astro.url.pathname;
const links = [
  { href: `${base}${prefix}/`, label: t(lang, 'nav.home') },
  { href: `${base}${prefix}/music/`, label: t(lang, 'nav.music') },
  { href: `${base}${prefix}/blog/`, label: t(lang, 'nav.blog') },
  { href: `${base}${prefix}/about/`, label: t(lang, 'nav.about') },
  { href: `${base}${prefix}/links/`, label: t(lang, 'nav.links') },
];
const isActive = (href: string) => {
  if (href === `${base}${prefix}/`) return current === `${base}${prefix}/` || current === `${base}${prefix}`;
  return current.startsWith(href);
};
const localeMatch = current.slice(base.length).match(/^\/(ko|ja)(\/|$)/);
const rest = localeMatch ? current.slice(base.length + 3) : current.slice(base.length);
const urlFor = (l: Lang) => `${base}${l === 'en' ? '' : `/${l}`}${rest || '/'}`;
const site = (Astro.site?.href ?? 'https://ghdalsrl06-cloud.github.io/').replace(/\/$/, '');
const canonical = `${site}${current}`;
const altUrl = (l: Lang) => `${site}${urlFor(l)}`;
const ogImage = `${site}${base}/images/og.png`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b16" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altUrl('en')} />
    <link rel="alternate" hreflang="ko" href={altUrl('ko')} />
    <link rel="alternate" hreflang="ja" href={altUrl('ja')} />
    <link rel="alternate" hreflang="x-default" href={altUrl('en')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='0.9em' font-size='80' fill='%23ff6ec7'%3E%E5%A4%9C%3C/text%3E%3C/svg%3E" />
    <link rel="alternate" type="application/rss+xml" title="SHINYA / 深夜 — Blog" href={`${base}/rss.xml`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <title>{title}</title>
  </head>
  <body>
    <div class="bg-glow" aria-hidden="true"></div>
    <NightSky />
    <nav class="site-nav">
      <div class="inner">
        <a href={`${base}${prefix}/`} class="brand"><span class="jp">深夜</span><span class="en">Shinya</span></a>
        <div class="nav-right">
          <ul class="nav-links">
            {links.map((l) => (
              <li><a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a></li>
            ))}
          </ul>
          <div class="lang-switch" aria-label="Language">
            <a href={urlFor('en')} class={lang === 'en' ? 'active' : ''} lang="en">EN</a>
            <span aria-hidden="true">·</span>
            <a href={urlFor('ko')} class={lang === 'ko' ? 'active' : ''} lang="ko">한국어</a>
            <span aria-hidden="true">·</span>
            <a href={urlFor('ja')} class={lang === 'ja' ? 'active' : ''} lang="ja">日本語</a>
          </div>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p class="jp">深夜 — 夜はまだ長い</p>
      <p>{t(lang, 'footer.copy')}</p>
      <p class="footer-links"><a href={`${base}/rss.xml`}>RSS</a></p>
    </footer>
    <RainToggle />
  </body>
</html>
