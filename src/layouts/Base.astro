---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { t, type Lang } from '../i18n/ui';
import { CHANNELS } from '../lib/studio';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
  // False for pages that exist in one language only (404). Their language
  // switcher points at the locale home instead of a translated path that was
  // never built, and they advertise no hreflang alternates.
  localized?: boolean;
}

const {
  title = 'SHINYA Studio',
  description = 'SHINYA Studio is a small studio that makes videos late at night: AI dramas, animation and music videos.',
  lang = 'en',
  ogImage: ogImageProp,
  localized = true,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'en' ? '' : `/${lang}`;
const current = Astro.url.pathname;
// The home's four sections, named in the page's own language. Episodes owns
// the series pages.
const home = `${base}${prefix}/`;
const links = [
  { href: `${home}#about`, label: t(lang, 'nav.about'), active: false },
  { href: `${home}#original`, label: t(lang, 'nav.episodes'), active: current.startsWith(`${home}series/`) },
  { href: `${home}#channels`, label: t(lang, 'nav.channels'), active: false },
  { href: `${home}#collab`, label: t(lang, 'nav.collab'), active: false },
];
const langs: [Lang, string][] = [['en', 'EN'], ['ko', '한국어'], ['ja', '日本語']];
const localeMatch = current.slice(base.length).match(/^\/(ko|ja)(\/|$)/);
const rest = localeMatch ? current.slice(base.length + 3) : current.slice(base.length);
const urlFor = (l: Lang) =>
  `${base}${l === 'en' ? '' : `/${l}`}${localized ? rest || '/' : '/'}`;
const site = (Astro.site?.href ?? 'https://shinya-music.com/').replace(/\/$/, '');
const canonical = `${site}${current}`;
const altUrl = (l: Lang) => `${site}${urlFor(l)}`;
const ogImage = ogImageProp
  ? ogImageProp.startsWith('http')
    ? ogImageProp
    : `${site}${base}/${ogImageProp.replace(/^\//, '')}`
  : `${site}${base}/images/og.png`;
const isDefaultOg = !ogImageProp;
const studioLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t(lang, 'brand.mark'),
  url: `${site}${base}/`,
  logo: `${site}${base}/images/og.png`,
  sameAs: [CHANNELS.studio.url, CHANNELS.music.url],
};
// 무료 방문자 통계(GoatCounter): https://www.goatcounter.com 의 사이트 코드.
const GOATCOUNTER_CODE = 'shinya';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0d0b" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="canonical" href={canonical} />
    {localized && <link rel="alternate" hreflang="en" href={altUrl('en')} />}
    {localized && <link rel="alternate" hreflang="ko" href={altUrl('ko')} />}
    {localized && <link rel="alternate" hreflang="ja" href={altUrl('ja')} />}
    {localized && <link rel="alternate" hreflang="x-default" href={altUrl('en')} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {isDefaultOg && <meta property="og:image:width" content="1200" />}
    {isDefaultOg && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%230f0d0b'/%3E%3Ccircle cx='50' cy='50' r='24' fill='%23ffb547'/%3E%3C/svg%3E" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(studioLd)} />
    <ClientRouter />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'nav.skip')}</a>
    <div class="bg-glow" aria-hidden="true"></div>
    <nav class="site-nav" aria-label={t(lang, 'nav.label')} data-nav data-open="false">
      <div class="inner">
        <a href={`${base}${prefix}/`} class="brand"><span class="mark">{t(lang, 'brand.mark')}</span></a>
        <div class="nav-right">
          <div class="nav-panel" id="nav-panel">
            <ul class="nav-links">
              {links.map((l) => (
                <li><a href={l.href} class={l.active ? 'active' : ''}>{l.label}</a></li>
              ))}
            </ul>
            <div class="lang-switch" role="group" aria-label={t(lang, 'nav.lang')}>
              {langs.map(([l, name], i) => (
                <>
                  {i > 0 && <span aria-hidden="true">·</span>}
                  <a href={urlFor(l)} class={lang === l ? 'active' : ''} lang={l} hreflang={l} aria-current={lang === l ? 'true' : undefined}>{name}</a>
                </>
              ))}
            </div>
          </div>
          <a class="btn btn-primary nav-cta" href={`${CHANNELS.studio.url}?sub_confirmation=1`} target="_blank" rel="noopener">{t(lang, 'nav.subscribe')}</a>
          <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-panel" aria-label={t(lang, 'nav.menu')}>
            <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
          </button>
        </div>
      </div>
    </nav>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href={`${base}${prefix}/`} class="brand"><span class="mark">{t(lang, 'brand.mark')}</span></a>
          <p>{t(lang, 'footer.tagline')}</p>
        </div>
        <div class="footer-col">
          <h4>{t(lang, 'footer.channels')}</h4>
          <ul>
            <li><a href={CHANNELS.studio.url} target="_blank" rel="noopener">{t(lang, 'footer.ytMain')}</a></li>
            <li><a href={CHANNELS.music.url} target="_blank" rel="noopener">{t(lang, 'footer.ytMusic')}</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>{t(lang, 'footer.site')}</h4>
          <ul>
            {links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>{t(lang, 'footer.copy')}</p>
        <p class="footer-langs">
          {langs.map(([l, name], i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <a href={urlFor(l)} lang={l} hreflang={l}>{name}</a>
            </>
          ))}
        </p>
      </div>
    </footer>
    <script>
      // Site-wide behaviour. The listeners sit on the document, so they survive
      // the body swap of a client-side navigation.

      // The menu on narrow screens: the button opens the panel; choosing a link,
      // pressing Escape or tapping outside closes it.
      const setNav = (open) => {
        const nav = document.querySelector('[data-nav]');
        if (!nav) return;
        nav.dataset.open = String(open);
        nav.querySelector('.nav-toggle')?.setAttribute('aria-expanded', String(open));
      };
      document.addEventListener('click', (e) => {
        const nav = document.querySelector('[data-nav]');
        if (!nav) return;
        if (e.target.closest('.nav-toggle')) { setNav(nav.dataset.open !== 'true'); return; }
        if (nav.dataset.open === 'true' && (e.target.closest('.nav-panel a') || !e.target.closest('.nav-panel'))) setNav(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const nav = document.querySelector('[data-nav]');
        if (nav?.dataset.open !== 'true') return;
        setNav(false);
        nav.querySelector('.nav-toggle')?.focus();
      });

      // GoatCounter: count client-side navigations too (initial load counts itself).
      let firstLoad = true;
      const countView = () => {
        if (firstLoad) { firstLoad = false; return; }
        window.goatcounter?.count?.({ path: location.pathname });
      };

      const initAll = () => { countView(); };
      initAll();
      document.addEventListener('astro:page-load', initAll);
    </script>
    {GOATCOUNTER_CODE && (
      <script
        is:inline
        data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </body>
</html>
