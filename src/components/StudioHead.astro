---
// A section's heading on the studio home: an eyebrow pill, the title in the
// display weight, and an optional one-line subtitle. The three rise in turn.
interface Props {
  kicker: string;
  title: string;
  sub?: string;
  mark?: string; // a glyph set before the title in the Japanese face, e.g. 深夜
}

const { kicker, title, sub, mark } = Astro.props;
---

<div class="studio-head" data-stagger>
  <p class="studio-pill">{kicker}</p>
  <h2 class="studio-title">{mark && <span class="studio-mark">{mark}</span>}{title}</h2>
  {sub && <p class="studio-sub">{sub}</p>}
</div>
