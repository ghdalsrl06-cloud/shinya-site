---
// The portfolio grid: every video across both channels, the music video
// first and the rest newest first. Pills above filter by kind, in the browser.
import ArtImg from './ArtImg.astro';
import StudioHead from './StudioHead.astro';
import type { Lang } from '../i18n/ui';
import { ymd } from '../lib/dates';
import { CHANNELS, COPY, VIDEOS, WORK_LABEL, videoName, ytThumb, ytUrl, type WorkType } from '../lib/studio';

const { lang } = Astro.props as { lang: Lang };
const c = COPY[lang];

const flagship = VIDEOS.filter((v) => v.type === 'mv');
const rest = VIDEOS.filter((v) => v.type !== 'mv').sort((a, b) => b.date.localeCompare(a.date));
const videos = [...flagship, ...rest];

const TYPES: WorkType[] = ['mv', 'drama', 'trailer'];
const count = (ty: WorkType) => videos.filter((v) => v.type === ty).length;
const TILE_SIZES = '(min-width: 900px) 230px, 45vw';
---

<section class="section studio-section" id="works">
  <StudioHead kicker={c.works.kicker} title={c.works.title} sub={c.works.sub} />
  <div data-works>
    <div class="studio-filters" role="group" aria-label={c.works.title}>
      <button type="button" data-filter="all" aria-pressed="true">{c.works.all}<b>{videos.length}</b></button>
      {TYPES.map((ty) => count(ty) > 0 && (
        <button type="button" data-filter={ty} aria-pressed="false">{c.works.filter[ty]}<b>{count(ty)}</b></button>
      ))}
    </div>

    <div class="studio-works" data-stagger>
      {videos.map((v) => (
        <a class="work" data-type={v.type} href={ytUrl(v)} target="_blank" rel="noopener">
          <span class:list={['work-frame', v.vertical && 'vert']}>
            {v.art ? (
              <ArtImg src={v.art.src} width={v.art.width} sizes={TILE_SIZES} alt="" />
            ) : (
              <>
                {v.vertical && <img class="work-bg" src={ytThumb(v.id, 'hqdefault')} alt="" aria-hidden="true" loading="lazy" decoding="async" />}
                <img class="work-fg" src={ytThumb(v.id)} onerror={`this.onerror=null;this.src='${ytThumb(v.id, 'hqdefault')}'`} alt="" loading="lazy" decoding="async" />
              </>
            )}
            <span class="work-play" aria-hidden="true"><span><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg></span></span>
            <span class="work-dur">{v.duration}</span>
          </span>
          <span class="work-cap">
            <small>{WORK_LABEL[v.type]}{v.episode && ` · ${v.episode}`}</small>
            <b>{videoName(v, lang)}</b>
            <span class="work-meta">{v.series ? `${v.title[lang]} · ` : v.sub ? `${v.sub[lang]} · ` : ''}{ymd(v.date)}</span>
          </span>
        </a>
      ))}
    </div>

    <p class="studio-more">
      <a href={CHANNELS.studio.url} target="_blank" rel="noopener">{c.works.more.studio} ↗</a>
      <a href={CHANNELS.music.url} target="_blank" rel="noopener">{c.works.more.music} ↗</a>
    </p>
  </div>
</section>

<script>
  // Filter pills: one pressed at a time, tiles of other kinds hidden.
  const init = () => {
    document.querySelectorAll('[data-works]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      const tiles = [...root.querySelectorAll('.work')];
      const pills = [...root.querySelectorAll('[data-filter]')];
      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const f = pill.dataset.filter;
          pills.forEach((p) => p.setAttribute('aria-pressed', String(p === pill)));
          tiles.forEach((tile) => { tile.hidden = f !== 'all' && tile.dataset.type !== f; });
        });
      });
    });
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>
