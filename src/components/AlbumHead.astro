---
// The top of an album panel on the music page: jacket, line and number,
// heading, blurb, a meta row, the store buttons and a compact tracklist.
// Everything comes from the album table and the collection, so the three
// music pages render this once per album and pass the language.
import ArtImg from './ArtImg.astro';
import ReleaseCountdown from './ReleaseCountdown.astro';
import { HYPERFOLLOW, isOut } from '../lib/presave';
import { t, type Lang } from '../i18n/ui';
import { jacketOf, jacketAlt, lineName, tabParts, type AlbumMeta } from '../lib/albums';
import { isReleased } from '../lib/covers';

interface Props {
  lang: Lang;
  meta: AlbumMeta;
  singles: any[];
  playlist?: any;
  out: boolean;
}

const { lang, meta, singles, playlist, out } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'en' ? '' : `/${lang}`;

// Next to the line name only the number is wanted.
const number = tabParts(meta, lang).no;
const COUNT = { en: (n: number) => `${n} tracks`, ko: (n: number) => `${n}곡`, ja: (n: number) => `${n}曲` };

const released = singles[0]?.data.releaseDate?.replaceAll('-', '.');
const releaseAt = singles[0]?.data.releaseAt;
const follow = HYPERFOLLOW.find((e) => e.n === meta.n);
const mix = playlist && isReleased(playlist) && playlist.data.youtubeId ? playlist : null;

// Running time and tempo range, shown only once every track carries them.
const secs = (d: string) => d.split(':').reduce((n, p) => n * 60 + Number(p), 0);
const total = singles.every((r) => r.data.duration) ? singles.reduce((n, r) => n + secs(r.data.duration), 0) : 0;
const totalLabel = total ? `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}` : null;
const bpms = singles.map((r) => r.data.bpm).filter((b) => typeof b === 'number');
const bpmLabel = bpms.length === singles.length
  ? Math.min(...bpms) === Math.max(...bpms) ? `${bpms[0]} BPM` : `${Math.min(...bpms)}–${Math.max(...bpms)} BPM`
  : null;

// The line under each title follows the card convention: the English page
// shows the name in the other script, ko its Korean, ja its Japanese.
const sub = (r: any) =>
  lang === 'ko' ? r.data.titleKo : lang === 'ja' ? r.data.titleJa : (r.data.titleEn ?? r.data.titleJa);

// A blurred copy of the jacket sits behind the whole block so each album
// tints its own panel. The 480px variant is plenty under a 70px blur.
const glow = `${base}/images/opt/covers/album-${meta.n}-w480.webp`;
---

<div class="album-head" style={`--jacket: url('${glow}')`}>
  <ArtImg class="album-jacket" src={jacketOf(meta)} width={2048} sizes="(min-width: 700px) 280px, 80vw" alt={jacketAlt(meta, lang)} />
  <div class="album-head-info">
    <p class="album-eyebrow"><span>{lineName(meta)}</span><span class="album-eyebrow-no">{number}</span></p>
    <h2>{meta.heading[lang]}</h2>
    <p class="album-note">{out ? meta.noteOut[lang] : meta.noteSoon[lang]}</p>
    <p class="album-meta">
      <span>{COUNT[lang](singles.length)}</span>
      {totalLabel && <span>{totalLabel}</span>}
      {bpmLabel && <span>{bpmLabel}</span>}
      {released && <span>{released} {t(lang, out ? 'album.released' : 'album.upcoming')}</span>}
      {!out && releaseAt && <ReleaseCountdown releaseAt={releaseAt} lang={lang} />}
    </p>
    {(follow || mix) && (
      <p class="album-cta">
        {follow && (
          <a class="btn btn-sm" href={follow.url} target="_blank" rel="noopener">
            {t(lang, isOut(follow) ? 'album.stream' : 'album.presave')}
          </a>
        )}
        {mix && (
          <a
            class="btn btn-sm btn-ghost"
            href={`https://www.youtube.com/watch?v=${mix.data.youtubeId}`}
            target="_blank"
            rel="noopener"
            data-play-mix={mix.data.youtubeId}
            data-play-title={`${meta.name} — MIX`}
          ><span aria-hidden="true">▶</span> {t(lang, 'album.play')}</a>
        )}
      </p>
    )}
    <ol class="album-tracks" aria-label={t(lang, 'album.tracklist')}>
      {singles.map((r) => (
        <li>
          <a href={`${base}${prefix}/music/${r.id}/`}>
            <span class="album-track-no">{String(r.data.track ?? 0).padStart(2, '0')}</span>
            <span class="album-track-text">
              <span class="album-track-title">{r.data.title}</span>
              {sub(r) && <span class="album-track-sub">{sub(r)}</span>}
            </span>
            {r.data.duration && <span class="album-track-time">{r.data.duration}</span>}
          </a>
        </li>
      ))}
    </ol>
  </div>
</div>

<script>
  // "Play this album" hands the mix to the mini player instead of leaving
  // the site. Modified clicks keep the plain link so a new tab still works.
  document.addEventListener('click', (e) => {
    const a = e.target.closest?.('[data-play-mix]');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
    e.preventDefault();
    document.dispatchEvent(new CustomEvent('shinya:play', { detail: { id: a.dataset.playMix, title: a.dataset.playTitle } }));
  });
</script>
