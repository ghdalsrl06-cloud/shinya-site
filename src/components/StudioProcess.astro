---
// How a commission runs: the heading holds the left, the four steps walk down
// the right, each a little further in than the last.
import StudioHead from './StudioHead.astro';
import type { Lang } from '../i18n/ui';
import { COPY } from '../lib/studio';

const { lang } = Astro.props as { lang: Lang };
const c = COPY[lang];
---

<section class="section studio-section" id="process">
  <div class="studio-process">
    <StudioHead kicker={c.process.kicker} title={c.process.title} sub={c.process.sub} />
    <ol class="studio-steps" data-stagger>
      {c.process.steps.map((s) => (
        <li>
          <b>{s.name}</b>
          <p>{s.desc}</p>
          <em>{s.note}</em>
        </li>
      ))}
    </ol>
  </div>
</section>
