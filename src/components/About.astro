---
// 01 — Who makes this: the statement, and the facts in a table beside it.
import SectionHead from './SectionHead.astro';
import type { Lang } from '../i18n/ui';
import { ABOUT } from '../lib/studio';

const { lang } = Astro.props as { lang: Lang };
const a = ABOUT[lang];
---

<section class="sec" id="about">
  <div class="container">
    <SectionHead no="01" kicker="About" title={a.title} sub={a.sub} />
    <div class="about-grid">
      <div class="about-copy" data-stagger>
        {a.paras.map((p) => <p>{p}</p>)}
      </div>
      <dl class="facts" data-stagger>
        {a.facts.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>
