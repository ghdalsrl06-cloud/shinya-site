---
// The three newest behind-the-track posts in this language, as a row.
import { getCollection } from 'astro:content';
import StudioHead from './StudioHead.astro';
import type { Lang } from '../i18n/ui';
import { ymd } from '../lib/dates';
import { COPY } from '../lib/studio';

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'en' ? '' : `/${lang}`;
const c = COPY[lang];

const mine = (id: string) => (lang === 'en' ? !id.includes('/') : id.startsWith(`${lang}/`));
const posts = (await getCollection('blog'))
  .filter((p) => mine(p.id) && !p.data.draft && p.data.date.valueOf() <= Date.now())
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const slug = (id: string) => id.replace(/^(ko|ja)\//, '');
---

{posts.length > 0 && (
  <section class="section studio-section" id="notes">
    <StudioHead kicker={c.notes.kicker} title={c.notes.title} />
    <ul class="studio-notes">
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{ymd(p.data.date)}</time>
          <a href={`${base}${prefix}/blog/${slug(p.id)}/`}>{p.data.title}</a>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
    <p class="studio-more"><a href={`${base}${prefix}/blog/`}>{c.notes.more} →</a></p>
  </section>
)}
