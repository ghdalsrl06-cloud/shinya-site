---
// The four things on offer, as a bento: the music video takes the tall cell
// with its own frame behind the copy, the drama and the trailer sit beside it
// over their thumbnails, and music runs wide underneath. Each cell ends with
// the piece that proves it and links there.
import ArtImg from './ArtImg.astro';
import StudioHead from './StudioHead.astro';
import type { Lang } from '../i18n/ui';
import { CHANNELS, COPY, VIDEOS, ytThumb, ytUrl } from '../lib/studio';

const { lang } = Astro.props as { lang: Lang };
const c = COPY[lang];

const mv = VIDEOS.find((v) => v.type === 'mv');
const firstDrama = VIDEOS.filter((v) => v.type === 'drama').sort((a, b) => a.date.localeCompare(b.date))[0];
const trailer = VIDEOS.find((v) => v.type === 'trailer');
const proof: Record<string, { href: string; thumb?: string }> = {
  mv: { href: mv ? ytUrl(mv) : CHANNELS.music.url },
  drama: { href: firstDrama ? ytUrl(firstDrama) : CHANNELS.studio.url, thumb: firstDrama && ytThumb(firstDrama.id, 'hqdefault') },
  trailer: { href: trailer ? ytUrl(trailer) : CHANNELS.studio.url, thumb: trailer && ytThumb(trailer.id, 'hqdefault') },
  music: { href: CHANNELS.music.url },
};
---

<section class="section studio-section" id="services">
  <StudioHead kicker={c.services.kicker} title={c.services.title} sub={c.services.sub} />
  <div class="studio-svc" data-stagger>
    {c.services.items.map((s) => (
      <div class:list={['bz', s.type]}>
        <a href={proof[s.type].href} target="_blank" rel="noopener">
          {s.type === 'mv' && mv?.art && (
            <span class="svc-art" aria-hidden="true"><ArtImg src={mv.art.src} width={mv.art.width} sizes="(min-width: 900px) 420px, 100vw" alt="" /></span>
          )}
          {proof[s.type].thumb && (
            <span class="svc-art" aria-hidden="true"><img src={proof[s.type].thumb} alt="" loading="lazy" decoding="async" /></span>
          )}
          <span class="k">{s.k}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          <span class="ref"><b>{s.refName}</b> · {s.ref}</span>
          <span class="svc-arrow" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </span>
        </a>
      </div>
    ))}
  </div>
</section>
