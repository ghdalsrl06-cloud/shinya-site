---
// The home's closing band: the way in for brands, games and artists —
// the portfolio, and the business e-mail on the studio channel.
import type { Lang } from '../i18n/ui';
import { COLLAB_URL, COPY } from '../lib/studio';

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'en' ? '' : `/${lang}`;
const c = COPY[lang].collab;
---

<section class="collab-band" id="collab">
  <div class="collab-band-in">
    <div class="collab-band-copy">
      <p class="orig-kicker">{c.kicker}</p>
      <h2>{c.title}</h2>
      <p>{c.lede}</p>
    </div>
    <p class="hero-cta collab-band-cta">
      <a class="btn btn-primary" href={`${base}${prefix}/portfolio/`}>
        {c.portfolio}
        <span class="btn-icon" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></span>
      </a>
      <a class="btn btn-ghost" href={COLLAB_URL} target="_blank" rel="noopener" title={c.contactNote}>
        {c.contact}
        <span class="btn-icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg></span>
      </a>
    </p>
  </div>
</section>
