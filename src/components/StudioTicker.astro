---
// The band under the hero: category · title for every video, across both channels.
import type { Lang } from '../i18n/ui';
import { VIDEOS, WORK_LABEL, videoName } from '../lib/studio';

const { lang } = Astro.props as { lang: Lang };
const items: [string, string][] = [];
for (const v of VIDEOS) {
  const name = videoName(v, lang);
  if (!items.some(([c, n]) => c === WORK_LABEL[v.type] && n === name)) items.push([WORK_LABEL[v.type], name]);
}
// Repeated until the band is long enough to scroll without a visible seam.
const loop = [...items, ...items, ...items, ...items];
---

<div class="ticker studio-ticker" aria-hidden="true">
  <div class="ticker-track">
    {[...loop, ...loop].map(([cat, title]) => (
      <span class="ticker-item"><span class="ticker-cat">{cat}</span>{title}<span class="ticker-sep">·</span></span>
    ))}
  </div>
</div>
