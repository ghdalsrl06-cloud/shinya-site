---
// 深夜 as the studio's own character: the art, who she is, and the way to the
// about page.
import ArtImg from './ArtImg.astro';
import StudioHead from './StudioHead.astro';
import type { Lang } from '../i18n/ui';
import { COPY } from '../lib/studio';

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'en' ? '' : `/${lang}`;
const c = COPY[lang];
---

<section class="section studio-section" id="shinya">
  <div class="studio-ip">
    <div class="studio-ip-art">
      <ArtImg src="images/about/character.jpg" width={810} sizes="(min-width: 760px) 320px, 80vw" alt="SHINYA / 深夜" />
      <span class="studio-ip-tag">{c.ip.tag}</span>
    </div>
    <div class="studio-ip-body">
      <StudioHead kicker={c.ip.kicker} title={c.ip.title} />
      <p class="studio-lede-sm">{c.ip.lede}</p>
      <p class="studio-ip-links">
        <a href={`${base}${prefix}/about/`}>{c.ip.about} →</a>
      </p>
    </div>
  </div>
</section>
