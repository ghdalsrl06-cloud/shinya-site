---
// The studio home's opening: the character art the site has always led with,
// now behind a pitch — what the studio makes, in one line — and the tools it
// is made with.
import ArtImg from './ArtImg.astro';
import TokyoClock from './TokyoClock.astro';
import type { Lang } from '../i18n/ui';
import { CHANNELS, COPY } from '../lib/studio';

const { lang } = Astro.props as { lang: Lang };
const c = COPY[lang];
---

<section class="hero hero-character studio-hero">
  <ArtImg class="hero-art" src="images/hero-character.jpg" width={2560} sizes="100vw" loading="eager" />
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="studio-eyebrow">
      <span class="studio-pill live">{c.hero.eyebrow}</span>
      <span class="studio-eyebrow-loc">Tokyo / Seoul</span>
      <TokyoClock lang={lang} />
    </div>
    <h1 class="studio-h1">{c.hero.h1[0]}<br />{c.hero.h1[1]}<em>{c.hero.h1[2]}</em></h1>
    <p class="studio-lede">{c.hero.lede}</p>
    <p class="hero-cta">
      <a class="btn btn-primary" href="#works">
        {c.hero.works}
        <span class="btn-icon" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></span>
      </a>
      <a class="btn btn-ghost" href={CHANNELS.studio.url} target="_blank" rel="noopener">
        {c.hero.channel}
        <span class="btn-icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg></span>
      </a>
    </p>
    <ul class="studio-stats">
      {c.hero.tools.map(([tool, role]) => (
        <li><b>{tool}</b><span>{role}</span></li>
      ))}
    </ul>
  </div>
</section>
