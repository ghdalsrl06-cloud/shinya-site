---
// The catalog: one card per series, cover on top, title and a count under it.
// A series with a video from the last two weeks wears NEW.
import ArtImg from './ArtImg.astro';
import type { Lang } from '../i18n/ui';
import { formatLabel, isNew, newUntil, seriesPath, videoCount, type Series } from '../lib/catalog';

interface Props {
  series: Series[];
  lang: Lang;
}

const { series, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="sgrid" data-stagger>
  {series.map((s) => (
    <a class="scard" href={seriesPath(s, lang, base)}>
      <span class="scard-thumb">
        {s.cover.startsWith('http') ? (
          <img src={s.cover} alt="" loading="lazy" decoding="async" />
        ) : (
          <ArtImg src={s.cover} width={s.coverWidth ?? 1280} sizes="(min-width: 900px) 230px, 45vw" alt="" />
        )}
        {isNew(s) && <span class="scard-new" data-new-until={newUntil(s)}>NEW</span>}
      </span>
      <b class="scard-title">{s.title}</b>
      <span class="scard-meta">{formatLabel(s, lang)} · {videoCount(s.episodes.length, lang)}</span>
    </a>
  ))}
</div>
