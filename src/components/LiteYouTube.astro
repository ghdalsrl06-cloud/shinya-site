---
// Lightweight YouTube embed: shows only the thumbnail until clicked,
// then swaps in the real iframe with autoplay. Pass `poster` (a path
// under /public or a full URL) to use custom art instead of the
// YouTube thumbnail — useful while a video is still private.
interface Props {
  id: string;
  title: string;
  poster?: string;
}

const { id, title, poster } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isLocalPoster = poster && !poster.startsWith('http');
const posterSrc = poster
  ? poster.startsWith('http')
    ? poster
    : `${base}/${poster.replace(/^\//, '')}`
  : `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
// local posters are the 1280px cover art — serve the WebP variants
const posterSrcset = isLocalPoster
  ? [480, 960, 1280]
      .map((w) => `${base}/images/opt/${poster.replace(/^\/?images\//, '').replace(/\.(jpe?g|png)$/i, '')}-w${w}.webp ${w}w`)
      .join(', ')
  : undefined;
---

<div class="video-wrap lite-yt" data-lite-yt data-video-id={id}>
  <button class="lite-yt-btn" type="button" data-title={title} aria-label={`Play: ${title}`}>
    <img src={posterSrc} srcset={posterSrcset} sizes="(min-width: 1000px) 920px, 100vw" alt="" loading="lazy" />
    <span class="lite-yt-play" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5.5v13l11-6.5z" />
      </svg>
    </span>
  </button>
</div>

<script>
  const bind = () => {
    document.querySelectorAll('[data-lite-yt]').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = '1';
      const btn = el.querySelector('button');
      btn?.addEventListener('click', () => {
        const id = el.getAttribute('data-video-id');
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
        iframe.title = btn.getAttribute('data-title') || 'YouTube video';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        el.replaceChildren(iframe);
      });
    });
  };
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
