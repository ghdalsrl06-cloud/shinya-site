---
// The banner at the top of the episodes section and of each series page: the
// copy on the left, the cover whole on the right (for a Shorts series, its
// latest episodes as posters), and the cover once more, out of focus, as the
// banner's light. On the home it links into the series;
// on the series page it shows the whole description and links out to YouTube.
import ArtImg from './ArtImg.astro';
import { t, type Lang } from '../i18n/ui';
import { formatLabel, isShorts, seriesPath, seriesUrl, videoCount, type Series } from '../lib/catalog';

interface Props {
  series: Series;
  lang: Lang;
  full?: boolean; // the series page: whole description, YouTube link
}

const { series: s, lang, full = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const remote = s.cover.startsWith('http');
// A Shorts series has no wide cover of its own: its three latest episodes stand as posters, newest first.
const posters = remote && isShorts(s) ? s.episodes.filter((e) => e.vertical).slice(-3).reverse() : [];
// On the home the cover is a second way into the series; on the series page it is a picture.
const Art = full ? 'div' : 'a';
---

<section class:list={['banner', full && 'full']} style={`--cover: url("${remote ? s.cover : `${base}${s.cover}`}")`}>
  <Art class:list={['banner-art', posters.length > 0 && 'posters']} href={full ? undefined : seriesPath(s, lang, base)} tabindex={full ? undefined : -1} aria-hidden="true">
    {posters.length > 0 ? (
      posters.map((e) => <span class="poster"><img src={e.thumb} alt="" loading="eager" decoding="async" /></span>)
    ) : remote ? (
      <img src={s.cover} alt="" loading="eager" decoding="async" />
    ) : (
      <ArtImg src={s.cover} width={s.coverWidth ?? 1280} sizes="(min-width: 760px) 480px, 100vw" alt="" loading="eager" />
    )}
  </Art>
  <div class="banner-body">
    <p class="banner-crumb"><span>{t(lang, 'orig.stamp')}</span><span class="sep" aria-hidden="true">/</span><span>{t(lang, s.kind === 'video' ? 'orig.single' : 'orig.ytSeries')}</span></p>
    <p class="banner-tags">
      <span class="tag">{t(lang, 'orig.tagYoutube')}</span>
      <span class="tag">{videoCount(s.episodes.length, lang)} · {t(lang, 'orig.all')}</span>
      <span class="tag">{formatLabel(s, lang)}</span>
    </p>
    {full ? <h1 class="banner-title">{s.title}</h1> : <h2 class="banner-title">{s.title}</h2>}
    {s.description && <p class="banner-desc">{s.description}</p>}
    <p class="banner-cta">
      {full ? (
        <a class="btn btn-ghost" href={seriesUrl(s)} target="_blank" rel="noopener">
          {t(lang, 'orig.onYoutube')}
          <span class="btn-icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg></span>
        </a>
      ) : (
        <a class="btn btn-primary" href={seriesPath(s, lang, base)}>
          <svg class="btn-play" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
          {t(lang, 'orig.watch')}
        </a>
      )}
    </p>
  </div>
</section>
