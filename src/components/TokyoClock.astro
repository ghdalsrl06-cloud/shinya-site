---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
---

<p class="tokyo-time" data-tokyo-clock data-msg-shinya={t(lang, 'clock.shinya')} data-msg-day={t(lang, 'clock.day')} data-msg-midnight={t(lang, 'clock.midnight')}>
  <span class="tt-label">東京</span>
  <span class="tt-time" data-time>--:--</span>
  <span class="tt-msg" data-msg></span>
</p>

<script>
  const fmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Asia/Tokyo',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
  const update = () => {
    const time = fmt.format(new Date());
    const hour = Number(time.slice(0, 2));
    const isShinya = hour >= 0 && hour < 4;
    // query fresh each tick so clocks on newly navigated pages are picked up
    const midnight = document.documentElement.classList.contains('midnight-mode');
    for (const el of document.querySelectorAll('[data-tokyo-clock]')) {
      el.querySelector('[data-time]').textContent = time;
      el.querySelector('[data-msg]').textContent =
        midnight && el.getAttribute('data-msg-midnight')
          ? el.getAttribute('data-msg-midnight')
          : el.getAttribute(isShinya ? 'data-msg-shinya' : 'data-msg-day');
      el.classList.toggle('is-shinya', isShinya || midnight);
    }
  };
  update();
  setInterval(update, 10_000);
  document.addEventListener('astro:page-load', update);
  addEventListener('shinya:midnight', update);
</script>
