---
// Responsive art image: serves WebP variants generated by
// scripts/optimize-images.mjs with the original JPG/PNG as fallback.
// `width` must be the original image width in px — the variant list is
// derived from it with the same rule the script uses.
interface Props {
  src: string; // path under /public, e.g. "images/hero-character.jpg"
  width: number;
  alt?: string;
  class?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const { src, width, alt = '', class: cls, sizes = '100vw', loading = 'lazy' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const clean = src.replace(/^\//, '');
const rel = clean.replace(/^images\//, '').replace(/\.(jpe?g|png)$/i, '');
const STEPS = [480, 960, 1440, 2560];
const widths = [...STEPS.filter((w) => w < width), width];
const srcset = widths.map((w) => `${base}/images/opt/${rel}-w${w}.webp ${w}w`).join(', ');
---

<img src={`${base}/${clean}`} srcset={srcset} sizes={sizes} alt={alt} class={cls} loading={loading} />
