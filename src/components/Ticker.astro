---
// The band under the hero: what this is about, scrolling without a seam.
import type { Lang } from '../i18n/ui';
import { TICKER } from '../lib/studio';

const { lang } = Astro.props as { lang: Lang };
const loop = [...TICKER[lang], ...TICKER[lang], ...TICKER[lang]];
---

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {[...loop, ...loop].map((item) => (
      <span class="ticker-item">{item}<span class="ticker-sep">•</span></span>
    ))}
  </div>
</div>
