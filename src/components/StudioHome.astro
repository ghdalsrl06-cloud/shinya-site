---
// The whole studio home in one place; the three locale index pages only pick
// the language. Hero, ticker and the closing band run full width, the rest
// sits in the container.
import Base from '../layouts/Base.astro';
import '../styles/studio.css'; // after Base, so it layers over global.css
import StudioHero from './StudioHero.astro';
import StudioTicker from './StudioTicker.astro';
import StudioServices from './StudioServices.astro';
import StudioWorks from './StudioWorks.astro';
import StudioProcess from './StudioProcess.astro';
import StudioIp from './StudioIp.astro';
import StudioNotes from './StudioNotes.astro';
import StudioCta from './StudioCta.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { albumsFrom } from '../lib/albums';
import { COPY, studioCounts } from '../lib/studio';

const { lang } = Astro.props as { lang: Lang };
const c = COPY[lang];
const counts = studioCounts(albumsFrom(await getCollection('music')), await getCollection('webtoon'));
---

<Base lang={lang} title={c.title} description={c.description(counts)}>
  <div class="studio-grain" aria-hidden="true"></div>
  <StudioHero lang={lang} />
  <StudioTicker lang={lang} />
  <div class="container">
    <StudioServices lang={lang} />
    <StudioWorks lang={lang} />
    <StudioProcess lang={lang} />
    <StudioIp lang={lang} />
    <StudioNotes lang={lang} />
  </div>
  <StudioCta lang={lang} />
</Base>

<script>
  // Scroll entry: each [data-stagger] group's children carry their index, and
  // the group is marked in once it reaches the viewport — the CSS does the
  // rest with a delay per index. Without IntersectionObserver everything is
  // simply shown.
  const init = () => {
    const groups = [...document.querySelectorAll('[data-stagger]')];
    groups.forEach((g) => [...g.children].forEach((el, i) => el.style.setProperty('--i', String(i))));
    if (!('IntersectionObserver' in window)) { groups.forEach((g) => g.classList.add('sv-in')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('sv-in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -6% 0px' });
    groups.forEach((g) => { if (!g.classList.contains('sv-in')) io.observe(g); });
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>
